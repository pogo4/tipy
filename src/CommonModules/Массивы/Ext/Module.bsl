#Область ПрограммныйИнтерфейс

// Создает массив из переданных значений.
//
// Позволяет в одну строку создать массив, содержащий до 10 элементов.
// Значения, переданные в параметрах, добавляются в массив в порядке
// следования параметров (от Значение1 к Значение10).
//
// Параметры:
//  Значение1 - Произвольный - 
//  Значение2 - Произвольный - 
//  Значение3 - Произвольный - 
//  Значение4 - Произвольный - 
//  Значение5 - Произвольный - 
//  Значение6 - Произвольный - 
//  Значение7 - Произвольный - 
//  Значение8 - Произвольный - 
//  Значение9 - Произвольный - 
//  Значение10 - Произвольный - 
//
// Возвращаемое значение:
//  Массив - массив, содержащий переданные значения. Завершающие значения Null
//           (идущие подряд с конца) отбрасываются. Внутренние значения Null
//           (находящиеся между значимыми элементами) заменяются на Неопределено.
//           Если все параметры равны Null или не переданы, возвращается
//           пустой массив.
//
// Пример:
//  // Массив из трех чисел:
//  Числа = Массивы.Создать(1, 2, 3); // [1, 2, 3]
//
//  // Пустой массив:
//  Пустой = Массивы.Создать(); // []
//
//  // Завершающие Null отбрасываются:
//  Результат = Массивы.Создать(1, 2, Неопределено, Null); // [1, 2, Неопределено]
//
//  // Пропущенные параметры заменяются на Неопределено:
//  Результат = Массивы.Создать(1, , 3); // [1, Неопределено, 3]
//
Функция Создать(Значение1 = Null,
	Значение2 = Null,
	Значение3 = Null,
	Значение4 = Null,
	Значение5 = Null,
	Значение6 = Null,
	Значение7 = Null,
	Значение8 = Null,
	Значение9 = Null,
	Значение10 = Null) Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	Результат.Добавить(Значение2);
	Результат.Добавить(Значение3);
	Результат.Добавить(Значение4);
	Результат.Добавить(Значение5);
	Результат.Добавить(Значение6);
	Результат.Добавить(Значение7);
	Результат.Добавить(Значение8);
	Результат.Добавить(Значение9);
	Результат.Добавить(Значение10);
	
	Пока Результат.Количество() > 0 Цикл
		
		ПоследнийИндекс = Результат.ВГраница();
		
		Если Результат[ПоследнийИндекс] <> Null Тогда
			Прервать;
		КонецЕсли;
		
		Результат.Удалить(ПоследнийИндекс);
		
	КонецЦикла;
	
	Для Индекс = 0 По Результат.ВГраница() Цикл
		Если Результат[Индекс] = Null Тогда
			Результат[Индекс] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает копию массива.
//
// Возвращает новый массив, содержащий те же элементы, что и исходный,
// в том же порядке. Исходный массив не изменяется. Если исходный массив пуст, возвращается 
// пустой массив.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив, копию которого необходимо создать.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий копию элементов исходного массива в исходном порядке.
//
// Пример:
//  ИсходныйМассив = Новый Массив;
//  ИсходныйМассив.Добавить(1);
//  ИсходныйМассив.Добавить(2);
//  ИсходныйМассив.Добавить(3);
//
//  Копия = Массивы.Копировать(ИсходныйМассив); // [1, 2, 3]
//
//  Копия.Добавить(4); // ИсходныйМассив = [1, 2, 3], Копия = [1, 2, 3, 4]
//
//  // Копия пустого массива:
//  Пустой = Новый Массив;
//  КопияПустого = Массивы.Копировать(Пустой); // []
//
Функция Копировать(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Если ТипЗнч(Массив) = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив(Массив);
	Иначе
		Результат = Новый Массив(Новый ФиксированныйМассив(Массив));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Сортирует массив по возрастанию или убыванию значений.
//
// Возвращает новый массив, содержащий элементы исходного массива,
// отсортированные в указанном направлении. Исходный массив не изменяется.
// Правила сравнения значений соответствуют стандартным правилам платформы
// (числа сравниваются как числа, строки — как строки и т.д.).
//
// Параметры:
//  Массив      - Массив, ФиксированныйМассив - исходный массив, элементы которого
//                необходимо отсортировать.
//  Направление - НаправлениеСортировки - направление сортировки:
//                  НаправлениеСортировки.Возр - по возрастанию (значение по умолчанию);
//                  НаправлениеСортировки.Убыв - по убыванию.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива, отсортированные
//           в указанном направлении. Если исходный массив пуст, возвращается
//           пустой массив.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(3);
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//
//  // Сортировка по возрастанию (по умолчанию):
//  Результат = Массивы.Сортировать(Исходный); // [1, 2, 3]
//
//  // Сортировка по убыванию:
//  Результат = Массивы.Сортировать(Исходный, НаправлениеСортировки.Убыв); // [3, 2, 1]
//
//  // Пустой массив:
//  Пустой = Новый Массив;
//  Результат = Массивы.Сортировать(Пустой); // []
//
Функция Сортировать(Массив, Знач Направление = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Если Направление = Неопределено Тогда
		Направление = НаправлениеСортировки.Возр;
	КонецЕсли;
	
	ПроверитьТипПараметра("Направление", Направление, "НаправлениеСортировки");
	
	ИсходныйМассив = Массив;
	
	Если ТипЗнч(ИсходныйМассив) = Тип("ФиксированныйМассив") Тогда
		ИсходныйМассив = Новый Массив(ИсходныйМассив);
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ИсходныйМассив);
	Список.СортироватьПоЗначению(Направление);
	
	Возврат Список.ВыгрузитьЗначения();
	
КонецФункции

// Проверяет, является ли массив пустым.
//
// Возвращает Истина, если переданный массив не содержит ни одного элемента,
// и Ложь в противном случае.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - проверяемый массив.
//
// Возвращаемое значение:
//  Булево - Истина, если массив пуст (количество элементов равно 0);
//           Ложь, если в массиве есть хотя бы один элемент.
//
// Пример:
//  ПустойМассив = Новый Массив;
//  Результат = Массивы.Пустой(ПустойМассив); // Истина
//
//  ЗаполненныйМассив = Новый Массив;
//  ЗаполненныйМассив.Добавить(1);
//  Результат = Массивы.Пустой(ЗаполненныйМассив); // Ложь
//
//  Фикс = Новый ФиксированныйМассив(ПустойМассив);
//  Результат = Массивы.Пустой(Фикс); // Истина
//
Функция Пустой(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Возврат Массив.Количество() = 0;
	
КонецФункции

// Возвращает первый элемент массива.
//
// Если массив пуст, возвращает Неопределено. Исходный массив не изменяется.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив.
//
// Возвращаемое значение:
//  Произвольный - первый элемент массива (с индексом 0), если массив не пуст;
//                 Неопределено, если массив пуст.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить("Первый");
//  Исходный.Добавить("Второй");
//
//  Результат = Массивы.ПервыйЭлемент(Исходный); // "Первый"
//
//  // Пустой массив:
//  Пустой = Новый Массив;
//  Результат = Массивы.ПервыйЭлемент(Пустой); // Неопределено
//
//  // Фиксированный массив:
//  Фикс = Новый ФиксированныйМассив(Исходный);
//  Результат = Массивы.ПервыйЭлемент(Фикс); // "Первый"
//
Функция ПервыйЭлемент(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Массив[0];
	
КонецФункции

// Возвращает последний элемент массива.
//
// Если массив пуст, возвращает Неопределено. Исходный массив не изменяется.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив.
//
// Возвращаемое значение:
//  Произвольный - последний элемент массива, если массив 
//                 не пуст; Неопределено, если массив пуст.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить("Первый");
//  Исходный.Добавить("Второй");
//
//  Результат = Массивы.ПоследнийЭлемент(Исходный); // "Второй"
//
//  // Пустой массив:
//  Пустой = Новый Массив;
//  Результат = Массивы.ПоследнийЭлемент(Пустой); // Неопределено
//
//  // Фиксированный массив:
//  Фикс = Новый ФиксированныйМассив(Исходный);
//  Результат = Массивы.ПоследнийЭлемент(Фикс); // "Второй"
//
Функция ПоследнийЭлемент(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Массив[Массив.ВГраница()];
	
КонецФункции

// Добавляет элемент в начало массива.
//
// Вставляет переданный элемент в позицию с индексом 0, сдвигая остальные элементы
// вправо. Массив изменяется на месте (мутабельная операция).
//
// Параметры:
//  Массив  - Массив - массив, в который добавляется элемент.
//  Значение - Произвольный - значение, которое необходимо вставить в начало массива.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить("Б");
//  Исходный.Добавить("В");
//
//  Массивы.ДобавитьВНачало(Исходный, "А");
//  // Исходный = ["А", "Б", "В"]
//
Процедура ДобавитьВНачало(Массив, Значение) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив");
	
	Массив.Вставить(0, Значение);
	
КонецПроцедуры

// Возвращает массив с элементами в обратном порядке.
//
// Создает новый массив, в котором элементы исходного массива расположены
// в обратном порядке. Исходный массив не изменяется.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива в обратном
//           порядке. Если исходный массив пуст, возвращается пустой массив.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//
//  Результат = Массивы.Развернуть(Исходный); // [3, 2, 1]
//
//  // Пустой массив:
//  Пустой = Новый Массив;
//  Результат = Массивы.Развернуть(Пустой); // []
//
//  // Фиксированный массив:
//  Фикс = Новый ФиксированныйМассив(Исходный);
//  Результат = Массивы.Развернуть(Фикс); // [3, 2, 1]
//
Функция Развернуть(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Результат = Новый Массив;
	
	Для Индекс = 0 По Массив.ВГраница() Цикл
		Результат.Добавить(Массив[Массив.ВГраница() - Индекс]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает часть массива (срез) с указанного начального по указанный конечный индекс.
//
// Создает новый массив, содержащий элементы исходного массива с индекса
// НачальныйИндекс по индекс КонечныйИндекс включительно. Исходный массив не изменяется.
// 
// Поддерживается передача отрицательного начального индекса для отсчета с конца массива
// (например, -1 — последний элемент, -2 — предпоследний и т.д.).
//
// Параметры:
//  Массив         - Массив, ФиксированныйМассив - исходный массив.
//  НачальныйИндекс - Число - индекс первого элемента среза (включительно).
//                   Может быть отрицательным для отсчета от конца массива.
//                   Значение по умолчанию: 0.
//  КонечныйИндекс - Число - индекс последнего элемента среза (включительно).
//                   Если не передан, берется до конца массива
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий срез исходного массива.
//
// Выбрасывает исключение, если:
//  - Параметр 'НачальныйИндекс' или 'КонечныйИндекс' не являются числами.
//  - Модуль параметра 'НачальныйИндекс' больше наибольшего индекса в массиве.
//  - Параметр 'КонечныйИндекс' больше наибольшего индекса в массиве.
//  - Параметр 'КонечныйИндекс' меньше параметра 'НачальныйИндекс'.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить("А"); // 0
//  Исходный.Добавить("Б"); // 1
//  Исходный.Добавить("В"); // 2
//  Исходный.Добавить("Г"); // 3
//
//  Срез1 = Массивы.Срез(Исходный); // ["А", "Б", "В", "Г"]
//  Срез2 = Массивы.Срез(Исходный, 1, 2); // ["Б", "В"]
//  Срез3 = Массивы.Срез(Исходный, -2); // ["В", "Г"]
//  Срез4 = Массивы.Срез(Исходный, , 1); // ["А", "Б"]
//
Функция Срез(
	Массив,
	Знач НачальныйИндекс = 0,
	Знач КонечныйИндекс = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("НачальныйИндекс", НачальныйИндекс, "Число");
	
	Если КонечныйИндекс = Неопределено Тогда
		КонечныйИндекс = Массив.ВГраница();
	КонецЕсли;
	
	ПроверитьТипПараметра("КонечныйИндекс", КонечныйИндекс, "Число");
	
	НачальныйИндексПоМодулю = НачальныйИндекс;
	
	Если НачальныйИндекс < 0 Тогда
		НачальныйИндексПоМодулю = -НачальныйИндекс;
		НачальныйИндекс = Массив.Количество() + НачальныйИндекс;
	КонецЕсли;
	
	Если НачальныйИндексПоМодулю > Массив.ВГраница() Тогда
		ВызватьИсключение "Начальный индекс не может быть больше количества элементов в массиве.";
	КонецЕсли;
	
	Если КонечныйИндекс > Массив.ВГраница() Тогда
		ВызватьИсключение "Конечный индекс не может быть больше количества элементов в массиве.";
	КонецЕсли;
	
	Если КонечныйИндекс < НачальныйИндекс Тогда
		ВызватьИсключение "Конечный индекс не может быть меньше начального индекса.";
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Индекс = НачальныйИндекс По КонечныйИндекс Цикл
		Результат.Добавить(Массив[Индекс]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Объединяет два массива в один.
//
// Возвращает новый массив, содержащий сначала все элементы первого массива,
// затем все элементы второго массива. Порядок следования элементов внутри
// каждого исходного массива сохраняется. Исходные массивы не изменяются.
//
// Параметры:
//  Массив1 - Массив, ФиксированныйМассив - первый массив, элементы которого
//            будут добавлены в результат первыми.
//  Массив2 - Массив, ФиксированныйМассив - второй массив, элементы которого
//            будут добавлены в результат после элементов первого массива.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий все элементы обоих массивов. 
//           Если оба массива пусты, возвращается пустой массив.
//
// Пример:
//  Массив1 = Новый Массив;
//  Массив1.Добавить(1);
//  Массив1.Добавить(2);
//
//  Массив2 = Новый Массив;
//  Массив2.Добавить(3);
//  Массив2.Добавить(4);
//
//  Результат = Массивы.Объединить(Массив1, Массив2); // [1, 2, 3, 4]
//
//  // Объединение с пустым массивом:
//  Пустой = Новый Массив;
//  Результат = Массивы.Объединить(Массив1, Пустой); // [1, 2]
//  Результат = Массивы.Объединить(Пустой, Массив2); // [3, 4]
//
Функция Объединить(Массив1, Массив2) Экспорт
	
	ПроверитьТипПараметра("Массив1", Массив1, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Массив2", Массив2, "Массив, ФиксированныйМассив");
	
	Результат = Копировать(Массив1);
	
	Для Каждого Элемент Из Массив2 Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает минимальное значение из массива для указанного примитивного типа.
//
// Элементы массива, тип которых не совпадает с заданным, игнорируются.
// Если массив пуст или не содержит значений указанного типа, возвращает Неопределено.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив      - Массив, ФиксированныйМассив - исходный массив.
//  ТипЗначения - Строка - имя примитивного типа, значения которого участвуют в сравнении.
//                Допустимые значения "Число", "Строка", "Дата", "Булево".
//                Значение по умолчанию: "Число".
//
// Возвращаемое значение:
//  Произвольный, Неопределено - минимальное значение указанного типа из переданного
//                               массива; Неопределено, если массив пуст или не содержит
//                               значений этого типа.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является массивом или фиксированным массивом.
//  - Параметр 'ТипЗначения' не является строкой.
//  - Параметр 'ТипЗначения' не входит в список допустимых примитивных типов.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить("Яблоко");
//  Исходный.Добавить("Апельсин");
//  Исходный.Добавить("Банан");
//
//  Результат = Массивы.Минимум(Исходный, "Строка"); // "Апельсин"
//
//  // Смешанный массив, поиск минимума по числам (по умолчанию):
//  Смешанный = Новый Массив;
//  Смешанный.Добавить("Строка");
//  Смешанный.Добавить(5);
//  Смешанный.Добавить(2);
//
//  Результат = Массивы.Минимум(Смешанный); // 2
//
Функция Минимум(Массив, ТипЗначения = "Число") Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("ТипЗначения", ТипЗначения, "Строка");
	
	ТипыДляСравнения = ПримитивныеТипыДляСравнения();
	
	Если ТипыДляСравнения.Найти(ТипЗначения) = Неопределено Тогда
		ВызватьИсключение "Недопустимый тип значения для сравнения.";
	КонецЕсли;
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Минимум = Неопределено;
	ТипДляСравнения = Тип(ТипЗначения);
	
	Для Каждого Элемент Из Массив Цикл
		
		Если ТипЗнч(Элемент) = ТипДляСравнения
			И (Минимум = Неопределено 
				Или Элемент < Минимум) Тогда
			
			Минимум = Элемент;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Минимум;
	
КонецФункции

// Возвращает максимальное значение из массива для указанного примитивного типа.
//
// Элементы массива, тип которых не совпадает с заданным, игнорируются.
// Если массив пуст или не содержит значений указанного типа, возвращает Неопределено.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив      - Массив, ФиксированныйМассив - исходный массив.
//  ТипЗначения - Строка - имя примитивного типа, значения которого участвуют в сравнении.
//                Допустимые значения "Число", "Строка", "Дата", "Булево".
//                Значение по умолчанию: "Число".
//
// Возвращаемое значение:
//  Произвольный, Неопределено - максимальное значение указанного типа из переданного
//                               массива; Неопределено, если массив пуст или не содержит
//                               значений этого типа.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является массивом или фиксированным массивом.
//  - Параметр 'ТипЗначения' не является строкой.
//  - Параметр 'ТипЗначения' не входит в список допустимых примитивных типов.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(3);
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//
//  Результат = Массивы.Максимум(Исходный); // 3
//
//  // Массив строк:
//  Строки = Новый Массив;
//  Строки.Добавить("Яблоко");
//  Строки.Добавить("Апельсин");
//  Строки.Добавить("Банан");
//
//  Результат = Массивы.Максимум(Строки, "Строка"); // "Яблоко"
//
Функция Максимум(Массив, ТипЗначения = "Число") Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("ТипЗначения", ТипЗначения, "Строка");
	
	ТипыДляСравнения = ПримитивныеТипыДляСравнения();
	
	Если ТипыДляСравнения.Найти(ТипЗначения) = Неопределено Тогда
		ВызватьИсключение "Недопустимый тип значения для сравнения.";
	КонецЕсли;
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Максимум = Неопределено;
	ТипДляСравнения = Тип(ТипЗначения);
	
	Для Каждого Элемент Из Массив Цикл
		
		Если ТипЗнч(Элемент) = ТипДляСравнения
			И (Максимум = Неопределено 
				Или Элемент > Максимум) Тогда
			
			Максимум = Элемент;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Максимум;
	
КонецФункции

// Возвращает сумму всех числовых элементов массива.
//
// Элементы массива, не являющиеся числами, игнорируются при суммировании.
// Если массив пуст или не содержит ни одного числа, возвращает 0.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив.
//
// Возвращаемое значение:
//  Число - сумма всех числовых элементов массива; 0, если массив пуст
//          или не содержит чисел.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//
//  Результат = Массивы.Сумма(Исходный); // 6
//
//  // Массив со смешанными типами:
//  Смешанный = Новый Массив;
//  Смешанный.Добавить("Строка");
//  Смешанный.Добавить(5);
//  Смешанный.Добавить(Неопределено);
//  Смешанный.Добавить(2);
//
//  Результат = Массивы.Сумма(Смешанный); // 7
//
Функция Сумма(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Результат = 0;
	
	Для Каждого Элемент Из Массив Цикл
		Если ТипЗнч(Элемент) = Тип("Число") Тогда
			Результат = Результат + Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив уникальных значений исходного массива.
//
// Результат содержит значения в порядке их первого появления в исходном массиве.
// Сравнение значений выполняется платформой.
//
// Параметры:
//  Массив - Массив, ФиксированныйМассив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий уникальные значения исходного массива
//           в порядке первого появления.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(1);
//  Исходный.Добавить(3);
//  Уникальные = Массивы.Свернуть(Исходный); // [1, 2, 3]
//
Функция Свернуть(Массив) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Результат = Новый Массив;
	Уникальные = Новый Соответствие;
	
	Для Каждого Элемент Из Массив Цикл
		Если Уникальные[Элемент] = Неопределено Тогда
			Уникальные.Вставить(Элемент, Истина);
			Результат.Добавить(Элемент); 
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Разбивает массив на группы (подмассивы) заданного размера.
//
// Возвращает новый массив, элементами которого являются массивы (группы).
// Каждая группа содержит не более РазмерГруппы элементов исходного массива.
// Порядок элементов сохраняется. Если количество элементов в исходном массиве
// не кратно размеру группы, последняя группа будет содержать меньше элементов.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив       - Массив, ФиксированныйМассив - исходный массив, который необходимо разбить.
//  РазмерГруппы - Число - количество элементов в каждой группе (целое число > 0).
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий подмассивы (группы) элементов.
//           Если исходный массив пуст, возвращается пустой массив.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'РазмерГруппы' не является числом.
//  - Параметр 'РазмерГруппы' не является целым числом.
//  - Параметр 'РазмерГруппы' меньше или равен нулю.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//  Исходный.Добавить(4);
//  Исходный.Добавить(5);
//
//  Результат = Массивы.РазбитьПо(Исходный, 2); 
//  // Результат = [[1, 2], [3, 4], [5]]
//
Функция РазбитьПо(Массив, РазмерГруппы) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("РазмерГруппы", РазмерГруппы, "Число");
	
	Если Цел(РазмерГруппы) <> РазмерГруппы Тогда
		ВызватьИсключение "Параметр ""РазмерГруппы"" должен быть целым числом.";
	КонецЕсли;
	
	Если РазмерГруппы <= 0 Тогда
		ВызватьИсключение "Параметр ""РазмерГруппы"" должен быть больше нуля.";
	КонецЕсли;
	
	Результат = Новый Массив;
	ТекущаяГруппа = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
		
		ТекущаяГруппа.Добавить(Элемент);
		
		Если ТекущаяГруппа.Количество() = РазмерГруппы Тогда
			Результат.Добавить(ТекущаяГруппа);
			ТекущаяГруппа = Новый Массив;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТекущаяГруппа.Количество() > 0 Тогда
		Результат.Добавить(ТекущаяГруппа);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Разбивает массив на заданное количество частей (групп) максимально равномерно.
//
// Элементы исходного массива распределяются по группам по порядку. Если количество
// элементов не делится нацело на количество частей, первые группы получают на один
// элемент больше, чем последующие.
//
// Параметры:
//  Массив            - Массив, ФиксированныйМассив - исходный массив.
//  КоличествоЧастей  - Число - количество частей, на которое нужно разбить массив.
//                      Должно быть целым положительным числом.
//
// Возвращаемое значение:
//  Массив - массив массивов. Содержит КоличествоЧастей элементов, каждый из которых
//           является Массивом. Если исходный массив пуст, возвращается КоличествоЧастей
//           пустых массивов.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'КоличествоЧастей' не является числом.
//  - Параметр 'КоличествоЧастей' не является целым числом.
//  - Параметр 'КоличествоЧастей' меньше или равен нулю.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//  Исходный.Добавить(4);
//  Исходный.Добавить(5);
//  Части = Массивы.РазбитьНа(Исходный, 2); // [[1, 2, 3], [4, 5]]
//
Функция РазбитьНа(Массив, КоличествоЧастей) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("КоличествоЧастей", КоличествоЧастей, "Число");
	
	Если Цел(КоличествоЧастей) <> КоличествоЧастей Тогда
		ВызватьИсключение "Параметр ""КоличествоЧастей"" должен быть целым числом.";
	КонецЕсли;
	
	Если КоличествоЧастей <= 0 Тогда
		ВызватьИсключение "Параметр ""КоличествоЧастей"" должен быть больше нуля.";
	КонецЕсли;
	
	Результат = Новый Массив;
	Всего = Массив.Количество();
	
	Если Всего = 0 Тогда
		
		Для Индекс = 0 По КоличествоЧастей - 1 Цикл
			Результат.Добавить(Новый Массив);
		КонецЦикла;
		
		Возврат Результат;
		
	КонецЕсли;
	
	БазовыйРазмер = Цел(Всего / КоличествоЧастей);
	Остаток = Всего % КоличествоЧастей;
	
	НачалоГруппы = 0;
	
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		
		РазмерГруппы = БазовыйРазмер;
		
		Если Индекс < Остаток Тогда
			РазмерГруппы = РазмерГруппы + 1;
		КонецЕсли;
		
		Группа = Новый Массив;
		
		Для ИндексИсходногоМассива = НачалоГруппы По НачалоГруппы + РазмерГруппы - 1 Цикл
			Группа.Добавить(Массив[ИндексИсходногоМассива]);
		КонецЦикла;
		
		Результат.Добавить(Группа);
		НачалоГруппы = НачалоГруппы + РазмерГруппы;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Фильтрует массив по заданному условию сравнения.
//
// Возвращает новый массив, содержащий только те элементы исходного массива,
// которые удовлетворяют условию сравнения с заданным значением. Вид сравнения
// задается перечислением ВидСравненияКомпоновкиДанных. Исходный массив не изменяется.
// Для видов сравнения Содержит, НеСодержит, НачинаетсяС, НеНачинаетсяС сравнение
// выполняется без учета регистра.
//
// Параметры:
//  Массив           - Массив, ФиксированныйМассив - исходный массив.
//  ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения. Не поддерживаются:
//                 ВИерархии, НеВИерархии, ВСпискеПоИерархии, НеВСпискеПоИерархии,
//                 Подобно и НеПодобно.
//  Значение     - Произвольный - значение, с которым сравниваются элементы массива.
//                 Допустимый тип зависит от вида сравнения:
//                  - для Больше, БольшеИлиРавно, Меньше, МеньшеИлиРавно: Число, Строка, Дата;
//                  - для ВСписке, НеВСписке: СписокЗначений, Массив, ФиксированныйМассив;
//                  - для Содержит, НеСодержит, НачинаетсяС, НеНачинаетсяС: Строка;
//                  - для остальных видов (Равно, НеРавно, Заполнено, НеЗаполнено): произвольный.
//                 Для видов Заполнено и НеЗаполнено значение игнорируется.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы, удовлетворяющие условию.
//           Если ни один элемент не удовлетворяет условию, возвращается пустой массив.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'ВидСравнения' не является значением перечисления ВидСравненияКомпоновкиДанных.
//  - Параметр 'ВидСравнения' не поддерживается.
//  - Тип параметра 'Значение' недопустим для указанного вида сравнения.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(5);
//  Исходный.Добавить(3);
//  Исходный.Добавить(8);
//
//  Результат = Массивы.Фильтровать(Исходный, ВидСравненияКомпоновкиДанных.Больше, 3);
//  // Результат = [5, 8]
//
//  СписокДопустимых = Новый Массив;
//  СписокДопустимых.Добавить(1);
//  СписокДопустимых.Добавить(2);
//  СписокДопустимых.Добавить(3);
//
//  Результат = Массивы.Фильтровать(Исходный, ВидСравненияКомпоновкиДанных.ВСписке, СписокДопустимых);
//  // Результат = [1, 3]
//
Функция Фильтровать(Массив, ВидСравнения, Значение = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("ВидСравнения", ВидСравнения, "ВидСравненияКомпоновкиДанных");
	ПроверитьПоддерживаетсяЛиВидСравнения(ВидСравнения);
	ПроверитьТипЗначенияСравненияПоВидуСравнения(Значение, ВидСравнения);
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
		
		Если СоответствуетУсловию(Элемент, ВидСравнения, Значение) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Исключает указанные значения из массива.
//
// Возвращает новый массив, содержащий элементы исходного массива, за исключением
// указанных значений. Порядок следования оставшихся элементов сохраняется.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив   - Массив, ФиксированныйМассив - исходный массив, из которого необходимо
//             исключить значения.
//  Значения - Произвольный - значение или массив значений, которые нужно исключить.
//             Если требуется исключить значение, являющееся массивом, его
//             необходимо перед вызовом обернуть в массив, иначе оно будет воспринято
//             как список исключаемых значений.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива, за исключением
//           указанных значений. Если в исходном массиве нет исключаемых значений,
//           возвращается копия исходного массива.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//
//  // Исключение одного значения:
//  Результат = Массивы.Исключить(Исходный, 2); // [1, 3]
//
//  // Исключение нескольких значений:
//  Исключаемые = Новый Массив;
//  Исключаемые.Добавить(1);
//  Исключаемые.Добавить(3);
//  Результат = Массивы.Исключить(Исходный, Исключаемые); // [2]
//
Функция Исключить(Массив, Значения) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	ИсключаемыеЗначения = Новый Соответствие;
	
	Если ТипЗнч(Значения) = Тип("Массив") 
		Или ТипЗнч(Значения) = Тип("ФиксированныйМассив") Тогда
		
		Для Каждого ИсключаемоеЗначение Из Значения Цикл
			ИсключаемыеЗначения.Вставить(ИсключаемоеЗначение, Истина);
		КонецЦикла;
		
	Иначе
		ИсключаемыеЗначения.Вставить(Значения, Истина);
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
		
		Если ИсключаемыеЗначения[Элемент] = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает пересечение двух массивов.
//
// Создает новый массив, содержащий уникальные элементы, которые присутствуют
// как в первом, так и во втором массиве. Дубликаты в результате исключаются.
// Исходные массивы не изменяются.
//
// Внимание: порядок элементов в результате соответствует порядку их следования
// в том массиве, который был больше (или в Массив1, если их длины равны).
//
// Параметры:
//  Массив1 - Массив, ФиксированныйМассив - первый массив для сравнения.
//  Массив2 - Массив, ФиксированныйМассив - второй массив для сравнения.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий уникальные элементы, присутствующие
//           в обоих исходных массивах. Если один из исходных массивов пуст
//           или общих элементов нет, возвращается пустой массив.
//
// Пример:
//  Массив1 = Новый Массив;
//  Массив1.Добавить(1);
//  Массив1.Добавить(3);
//  Массив1.Добавить(2);
//
//  Массив2 = Новый Массив;
//  Массив2.Добавить(2);
//  Массив2.Добавить(3);
//  Массив2.Добавить(4);
//
//  Результат = Массивы.Пересечение(Массив1, Массив2); 
//  // Результат = [3, 2] (порядок соответствует Массив1)
//
Функция Пересечение(Массив1, Массив2) Экспорт
	
	ПроверитьТипПараметра("Массив1", Массив1, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Массив2", Массив2, "Массив, ФиксированныйМассив");
	
	Результат = Новый Массив;
	
	Если Массив1.Количество() = 0
		Или Массив2.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Больший = Массив1;
	Меньший = Массив2;
	
	Если Массив2.Количество() > Массив1.Количество() Тогда
		Больший = Массив2;
		Меньший = Массив1;
	КонецЕсли;
	
	Индекс = Новый Соответствие;
	Для Каждого Элемент Из Меньший Цикл
		Индекс.Вставить(Элемент, Истина);
	КонецЦикла;
	
	Для Каждого Элемент Из Больший Цикл
		
		Если Индекс[Элемент] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Результат.Добавить(Элемент);
		Индекс.Удалить(Элемент);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Проверяет поэлементное равенство двух массивов.
//
// Возвращает Истина, если оба массива имеют одинаковую длину и каждый элемент
// первого массива равен элементу второго массива на той же позиции (с учетом типа).
// Возвращает Ложь в противном случае. Исходные массивы не изменяются.
//
// Внимание: сравнение выполняется по ссылке. Если две структуры имеют одинаковый состав
// и значения, но являются разными объектами, функция вернет Ложь.
//
// Параметры:
//  Массив1 - Массив, ФиксированныйМассив - первый массив для сравнения.
//  Массив2 - Массив, ФиксированныйМассив - второй массив для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если массивы идентичны (длина и элементы совпадают);
//           Ложь, если длины различаются или хотя бы один элемент отличается
//           по типу или значению.
//
// Пример:
//  Массив1 = Новый Массив;
//  Массив1.Добавить(1);
//  Массив1.Добавить(2);
//
//  Массив2 = Новый Массив;
//  Массив2.Добавить(1);
//  Массив2.Добавить(2);
//
//  Результат = Массивы.Идентичны(Массив1, Массив2); // Истина
//
//  // Сравнение обычного и фиксированного массива:
//  Фикс = Новый ФиксированныйМассив(Массив2);
//  Результат = Массивы.Идентичны(Массив1, Фикс); // Истина
//
Функция Идентичны(Массив1, Массив2) Экспорт
	
	ПроверитьТипПараметра("Массив1", Массив1, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Массив2", Массив2, "Массив, ФиксированныйМассив");
	
	Если Массив1.Количество() <> Массив2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 0 По Массив1.ВГраница() Цикл
		
		Значение1 = Массив1[Индекс];
		Значение2 = Массив2[Индекс];
		
		Если ТипЗнч(Значение1) <> ТипЗнч(Значение2)
			Или Значение1 <> Значение2 Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Проверяет, содержит ли массив указанное значение.
//
// Возвращает Истина, если в массиве есть хотя бы один элемент, равный искомому
// значению, и Ложь в противном случае. Исходный массив не изменяется.
//
// Параметры:
//  Массив   - Массив, ФиксированныйМассив - исходный массив для поиска.
//  Значение - Произвольный - значение, наличие которого необходимо проверить.
//
// Возвращаемое значение:
//  Булево - Истина, если значение найдено в массиве; Ложь, если не найдено.
//
// Пример:
//  Исходный = Новый Массив;
//  Исходный.Добавить(1);
//  Исходный.Добавить(2);
//  Исходный.Добавить(3);
//
//  Результат = Массивы.Содержит(Исходный, 2); // Истина
//  Результат = Массивы.Содержит(Исходный, 5); // Ложь
//
Функция Содержит(Массив, Значение) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Возврат Массив.Найти(Значение) <> Неопределено;
	
КонецФункции

// Преобразует многомерный массив в одномерный, разворачивая вложенные
// массивы на указанное количество уровней. Исходный массив не изменяется.
//
// Если параметр КоличествоУровней не указан, массив разворачивается
// полностью (на всю глубину). Если указано положительное число — разворачивается
// на указанное количество уровней. Вложенные ФиксированныеМассивы также
// разворачиваются.
//
// При передаче пустого массива возвращается пустой массив, параметр КоличествоУровней
// игнорируется.
//
// Параметры:
//  Массив             - Массив, ФиксированныйМассив - исходный массив.
//  КоличествоУровней  - Число - количество уровней вложенности, на которое
//                       нужно развернуть массив.
//                       Неопределено (по умолчанию) — развернуть полностью.
//
// Возвращаемое значение:
//  Массив - новый массив с развёрнутыми элементами.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом;
//  - Параметр 'КоличествоУровней' не является числом;
//  - Параметр 'КоличествоУровней' меньше или равен нулю.
//
// Пример:
//  Исходный = Новый Массив;
//  Вложенный = Новый Массив;
//  Вложенный.Добавить(2);
//  Вложенный.Добавить(3);
//  Исходный.Добавить(1);
//  Исходный.Добавить(Вложенный);
//  Исходный.Добавить(4);
//  Плоский = Массивы.Расплющить(Исходный); // [1, 2, 3, 4]
//  Плоский = Массивы.Расплющить(Исходный, 1); // [1, 2, 3, 4]
//
Функция Расплющить(Массив, КоличествоУровней = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	
	Если Массив.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Если КоличествоУровней = Неопределено Тогда
		КоличествоУровней = -1;
	КонецЕсли;
	
	ПроверитьТипПараметра("КоличествоУровней", КоличествоУровней, "Число");
	
	Если КоличествоУровней <> -1 И КоличествоУровней <= 0 Тогда
		ВызватьИсключение "Параметр ""КоличествоУровней"" должен быть положительным числом.";
	КонецЕсли;
	
	Если ТипЗнч(Массив) = Тип("ФиксированныйМассив") Тогда
		ИсходныйМассив = Новый Массив(Массив);
	Иначе
		ИсходныйМассив = Массив;
	КонецЕсли;
	
	Результат = Новый Массив;
	Возврат СделатьПлоскимРекурсивно(ИсходныйМассив, КоличествоУровней, Результат);
	
КонецФункции

#Область МассивыСтруктур

// Фильтрует массив структур по значению указанного свойства.
//
// Возвращает новый массив, содержащий только те элементы исходного массива,
// у которых значение свойства с именем Свойство удовлетворяет заданному условию.
// Элементы, не имеющие такого свойства, пропускаются и в результат не попадают.
// Исходный массив не изменяется.
//
// Параметры:
//  Массив       - Массив, ФиксированныйМассив - исходный массив, элементы которого
//                 должны иметь тип Структура или ФиксированнаяСтруктура.
//  Свойство     - Строка - имя свойства (ключа), значение которого проверяется.
//  ВидСравнения - ВидСравненияКомпоновкиДанных - вид сравнения. Не поддерживаются:
//                 ВИерархии, НеВИерархии, ВСпискеПоИерархии, НеВСпискеПоИерархии,
//                 Подобно и НеПодобно.
//  Значение     - Произвольный - значение, с которым сравнивается значение свойства.
//                 Допустимый тип зависит от вида сравнения:
//                  - для Больше, БольшеИлиРавно, Меньше, МеньшеИлиРавно: Число, Строка, Дата;
//                  - для ВСписке, НеВСписке: СписокЗначений, Массив, ФиксированныйМассив;
//                  - для Содержит, НеСодержит, НачинаетсяС, НеНачинаетсяС: Строка;
//                  - для остальных видов (Равно, НеРавно, Заполнено, НеЗаполнено): произвольный.
//                 Для видов Заполнено и НеЗаполнено значение игнорируется.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива, удовлетворяющие
//           условию. Если ни один элемент не подошел, возвращается пустой массив.
//           Элементы копируются по ссылке.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'Свойство' не является строкой.
//  - Параметр 'ВидСравнения' не является значением перечисления ВидСравненияКомпоновкиДанных.
//  - Параметр 'ВидСравнения' не поддерживается.
//  - Тип параметра 'Значение' недопустим для указанного вида сравнения.
//  - Элементы массива не являются Структурой или ФиксированнойСтруктурой.
//
// Пример:
//  Стр1 = Новый Структура("Цена", 150);
//  Стр2 = Новый Структура("Цена", 50);
//  Стр3 = Новый Структура("Цена", 200);
//
//  Массив = Новый Массив;
//  Массив.Добавить(Стр1);
//  Массив.Добавить(Стр2);
//  Массив.Добавить(Стр3);
//
//  Результат = Массивы.ФильтроватьПо(Массив, "Цена", ВидСравненияКомпоновкиДанных.Больше, 100);
//  // Результат = [Стр1, Стр3]
//
Функция ФильтроватьПо(Массив, Свойство, ВидСравнения, Значение = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Свойство", Свойство, "Строка");
	ПроверитьТипПараметра("ВидСравнения", ВидСравнения, "ВидСравненияКомпоновкиДанных");
	
	ПроверитьПоддерживаетсяЛиВидСравнения(ВидСравнения);
	ПроверитьТипЗначенияСравненияПоВидуСравнения(Значение, ВидСравнения);
	
	Результат = Новый Массив;
	
	Если Массив.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Элемент Из Массив Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента <> Тип("Структура")
			И ТипЭлемента <> Тип("ФиксированнаяСтруктура") Тогда
			
			ВызватьИсключение "Элемент массива должен иметь тип Структура или ФиксированнаяСтруктура.";
			
		КонецЕсли;
		
		Если Не Элемент.Свойство(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СоответствуетУсловию(Элемент[Свойство], ВидСравнения, Значение) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает элемент массива структур (или фиксированных структур) с минимальным
// значением указанного свойства.
//
// Элементы массива, не являющиеся структурами или фиксированными структурами,
// а также элементы без указанного свойства и элементы, тип значения свойства которых
// не совпадает с типом 'ТипЗначения', при поиске минимума пропускаются.
//
// Параметры:
//  Массив       - Массив, ФиксированныйМассив - массив, среди элементов которого
//                 выполняется поиск.
//  Свойство     - Строка - имя свойства, по значению которого выполняется поиск минимума.
//  ТипЗначения  - Строка - имя примитивного типа для сравнения значений свойства.
//                 Допустимые значения: "Число", "Строка", "Дата", "Булево".
//                 Значение по умолчанию: "Число".
//
// Возвращаемое значение:
//  Структура, ФиксированнаяСтруктура, Неопределено - элемент массива с минимальным
//             значением свойства 'Свойство'. Неопределено, если массив пуст или не найден
//             ни один подходящий элемент.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'Свойство' не является строкой.
//  - Параметр 'ТипЗначения' не является строкой.
//  - Значение 'ТипЗначения' отсутствует в списке примитивных типов для сравнения.
//
// Пример:
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Цена", 100));
//  Элементы.Добавить(Новый Структура("Цена", 50));
//  Минимальный = Массивы.МинимумПо(Элементы, "Цена"); // элемент с Цена = 50
//
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Имя", "Яблоко"));
//  Элементы.Добавить(Новый Структура("Имя", "Апельсин"));
//  Минимальный = Массивы.МинимумПо(Элементы, "Имя", "Строка"); // элемент с Имя = "Апельсин"
//
Функция МинимумПо(Массив, Свойство, ТипЗначения = "Число") Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Свойство", Свойство, "Строка");
	ПроверитьТипПараметра("ТипЗначения", ТипЗначения, "Строка");
	
	ТипыДляСравнения = ПримитивныеТипыДляСравнения();
	
	Если ТипыДляСравнения.Найти(ТипЗначения) = Неопределено Тогда
		ВызватьИсключение "Недопустимый тип значения для сравнения.";
	КонецЕсли;
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипДляСравнения = Тип(ТипЗначения);
	МинимальноеЗначение = Неопределено;
	МинимальныйЭлемент = Неопределено;
	
	Для Каждого Элемент Из Массив Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента <> Тип("Структура")
			И ТипЭлемента <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Элемент.Свойство(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущееЗначение = Элемент[Свойство];
		
		Если ТипЗнч(ТекущееЗначение) = ТипДляСравнения
			И (МинимальныйЭлемент = Неопределено
			Или ТекущееЗначение < МинимальноеЗначение) Тогда
			МинимальноеЗначение = ТекущееЗначение;
			МинимальныйЭлемент = Элемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МинимальныйЭлемент;
	
КонецФункции

// Возвращает элемент массива структур с максимальным значением указанного свойства.
//
// Элементы массива, не являющиеся структурами или фиксированными структурами,
// а также элементы без указанного свойства и элементы, тип значения свойства которых
// не совпадает с типом 'ТипЗначения', при поиске максимума пропускаются.
//
// Параметры:
//  Массив       - Массив, ФиксированныйМассив - массив, среди элементов которого
//                 выполняется поиск.
//  Свойство     - Строка - имя свойства, по значению которого выполняется поиск максимума.
//  ТипЗначения  - Строка - имя примитивного типа для сравнения значений свойства.
//                 Допустимые значения: "Число", "Строка", "Дата", "Булево".
//                 Значение по умолчанию: "Число".
//
// Возвращаемое значение:
//  Структура, ФиксированнаяСтруктура, Неопределено - элемент массива с максимальным
//             значением свойства Свойство. Неопределено, если массив пуст или не найден
//             ни один подходящий элемент.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'Свойство' не является строкой.
//  - Параметр 'ТипЗначения' не является строкой.
//  - Значение параметра 'ТипЗначения' отсутствует в списке примитивных типов для сравнения.
//
// Пример:
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Цена", 100));
//  Элементы.Добавить(Новый Структура("Цена", 50));
//  Максимальный = Массивы.МаксимумПо(Элементы, "Цена"); // элемент с Цена = 100
//
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Имя", "Яблоко"));
//  Элементы.Добавить(Новый Структура("Имя", "Апельсин"));
//  Максимальный = Массивы.МаксимумПо(Элементы, "Имя", "Строка"); // элемент с Имя = "Яблоко"
//
Функция МаксимумПо(Массив, Свойство, ТипЗначения = "Число") Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Свойство", Свойство, "Строка");
	ПроверитьТипПараметра("ТипЗначения", ТипЗначения, "Строка");
	
	ТипыДляСравнения = ПримитивныеТипыДляСравнения();
	
	Если ТипыДляСравнения.Найти(ТипЗначения) = Неопределено Тогда
		ВызватьИсключение "Недопустимый тип значения для сравнения.";
	КонецЕсли;
	
	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипДляСравнения = Тип(ТипЗначения);
	МаксимальноеЗначение = Неопределено;
	МаксимальныйЭлемент = Неопределено;
	
	Для Каждого Элемент Из Массив Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		
		Если ТипЭлемента <> Тип("Структура")
			И ТипЭлемента <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не Элемент.Свойство(Свойство) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекущееЗначение = Элемент[Свойство];
		
		Если ТипЗнч(ТекущееЗначение) = ТипДляСравнения
			И (МаксимальныйЭлемент = Неопределено
			Или ТекущееЗначение > МаксимальноеЗначение) Тогда
			МаксимальноеЗначение = ТекущееЗначение;
			МаксимальныйЭлемент = Элемент;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МаксимальныйЭлемент;
	
КонецФункции

// Возвращает новый массив структур, содержащий элементы исходного массива структур,
// отсортированные по значению указанного свойства.
//
// Элементы массива, не являющиеся структурами или фиксированными структурами,
// а также элементы без указанного свойства, участвуют в сортировке наравне 
// с остальными, как если бы они были структурой и у них было указанное свойство
// со значением Неопределено. 
//
// Параметры:
//  Массив       - Массив, ФиксированныйМассив - исходный массив структур
//                 или фиксированных структур.
//  Свойство     - Строка - имя свойства, по значению которого выполняется сортировка.
//  Направление  - НаправлениеСортировки - направление сортировки:
//                  НаправлениеСортировки.Возр - по возрастанию (значение по умолчанию);
//                  НаправлениеСортировки.Убыв - по убыванию.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива, отсортированные
//           по значению свойства Свойство.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'Свойство' не является строкой.
//  - Параметр 'Направление' не является значением НаправлениеСортировки.
//
// Пример:
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Цена", 100));
//  Элементы.Добавить(Новый Структура("Цена", 50));
//  Элементы.Добавить(Новый Структура("Цена", 75));
//  Отсортированный = Массивы.СортироватьПо(Элементы, "Цена"); // Цена: 50, 75, 100
//  Отсортированный = Массивы.СортироватьПо(Элементы, "Цена", НаправлениеСортировки.Убыв);
//  // Цена: 100, 75, 50
//
Функция СортироватьПо(Массив, Свойство, Знач Направление = Неопределено) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Свойство", Свойство, "Строка");
	
	Если Направление = Неопределено Тогда
		Направление = НаправлениеСортировки.Возр;
	КонецЕсли;
	
	ПроверитьТипПараметра("Направление", Направление, "НаправлениеСортировки");
	
	ИсходныйМассив = Массив;
	
	Если ТипЗнч(ИсходныйМассив) = Тип("ФиксированныйМассив") Тогда
		ИсходныйМассив = Новый Массив(ИсходныйМассив);
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	
	Для Индекс = 0 По Массив.ВГраница() Цикл
		
		Значение = Массив[Индекс];
		СортируемоеЗначение = Неопределено;
		
		Если (ТипЗнч(Значение) = Тип("Структура")
			Или ТипЗнч(Значение) = Тип("ФиксированнаяСтруктура"))
			И Значение.Свойство(Свойство) Тогда
			СортируемоеЗначение = Значение[Свойство];
		КонецЕсли;
		
		Список.Добавить(СортируемоеЗначение, Формат(Индекс, "ЧН=; ЧГ=0"));
		
	КонецЦикла;
	
	Список.СортироватьПоЗначению(Направление);
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаСписка Из Список Цикл
		Индекс = Число(СтрокаСписка.Представление);
		Результат.Добавить(Массив[Индекс]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает сумму значений указанного свойства элементов массива.
//
// Элементы массива, не являющиеся структурами или фиксированными структурами,
// а также элементы без указанного свойства и элементы, значение свойства которых
// не является числом, при суммировании пропускаются.
//
// Параметры:
//  Массив   - Массив, ФиксированныйМассив - массив структур или фиксированных структур.
//  Свойство - Строка - имя свойства, значения которого суммируются.
//
// Возвращаемое значение:
//  Число - сумма значений свойства Свойство. Если массив пуст или не найдено
//          ни одного числового значения, возвращает 0.
//
// Выбрасывает исключение, если:
//  - Параметр 'Массив' не является Массивом или ФиксированнымМассивом.
//  - Параметр 'Свойство' не является строкой.
//
// Пример:
//  Элементы = Новый Массив;
//  Элементы.Добавить(Новый Структура("Цена", 100));
//  Элементы.Добавить(Новый Структура("Цена", 50));
//  Итог = Массивы.СуммаПо(Элементы, "Цена"); // 150
//
Функция СуммаПо(Массив, Свойство) Экспорт
	
	ПроверитьТипПараметра("Массив", Массив, "Массив, ФиксированныйМассив");
	ПроверитьТипПараметра("Свойство", Свойство, "Строка");
	
	Результат = 0;
	
	Для Каждого Элемент Из Массив Цикл
		Если (ТипЗнч(Элемент) = Тип("Структура")
			Или ТипЗнч(Элемент) = Тип("ФиксированнаяСтруктура"))
			И Элемент.Свойство(Свойство)
			И ТипЗнч(Элемент[Свойство]) = Тип("Число") Тогда
			Результат = Результат + Элемент[Свойство];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ПроверитьТипПараметра(ИмяПараметра, Значение, ОжидаемыеТипы)		ОписаниеОжидаемыхТипов = Новый ОписаниеТипов(ОжидаемыеТипы);		Если Не ОписаниеОжидаемыхТипов.СодержитТип(ТипЗнч(Значение)) Тогда				СловоТип = ?(ОписаниеОжидаемыхТипов.Типы().Количество() = 1, "тип", "типы");				ТекстОшибки = СтрШаблон(			"Параметр ""%1"" должен иметь %2: %3.",			ИмяПараметра,			СловоТип,			ОжидаемыеТипы);				ВызватьИсключение ТекстОшибки;			КонецЕсли;	КонецПроцедурыФункция ПримитивныеТипыДляСравнения()		ПримитивныеТипыДляСравнения = Новый Массив;	ПримитивныеТипыДляСравнения.Добавить("Строка");	ПримитивныеТипыДляСравнения.Добавить("Число");	ПримитивныеТипыДляСравнения.Добавить("Дата");	ПримитивныеТипыДляСравнения.Добавить("Булево");		Возврат ПримитивныеТипыДляСравнения;	КонецФункцииПроцедура ПроверитьПоддерживаетсяЛиВидСравнения(ВидСравнения)		НеподдерживаемыВидыСравнения = Новый Массив;	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.ВИерархии);	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеВИерархии);	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии);	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии);	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.Подобно);	НеподдерживаемыВидыСравнения.Добавить(ВидСравненияКомпоновкиДанных.НеПодобно);		Если НеподдерживаемыВидыСравнения.Найти(ВидСравнения) <> Неопределено Тогда		ВызватьИсключение СтрШаблон("Вид сравнения ""%1"" не поддерживается.", ВидСравнения);	КонецЕсли;	КонецПроцедурыПроцедура ПроверитьТипЗначенияСравненияПоВидуСравнения(Значение, Вид)		ТипыЗначенийПоВидамСравнений = Новый Соответствие;	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.Больше, Новый ОписаниеТипов("Число, Строка, Дата"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Новый ОписаниеТипов("Число, Строка, Дата"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.Меньше, Новый ОписаниеТипов("Число, Строка, Дата"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Новый ОписаниеТипов("Число, Строка, Дата"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.ВСписке, Новый ОписаниеТипов("СписокЗначений, Массив, ФиксированныйМассив"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.НеВСписке, Новый ОписаниеТипов("СписокЗначений, Массив, ФиксированныйМассив"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.Содержит, Новый ОписаниеТипов("Строка"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.НеСодержит, Новый ОписаниеТипов("Строка"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.НачинаетсяС, Новый ОписаниеТипов("Строка"));	ТипыЗначенийПоВидамСравнений.Вставить(ВидСравненияКомпоновкиДанных.НеНачинаетсяС, Новый ОписаниеТипов("Строка"));		ДопустимыеТипыЗначения = ТипыЗначенийПоВидамСравнений[Вид];		Если ДопустимыеТипыЗначения = Неопределено Тогда		Возврат;	КонецЕсли;		ТипЗначения = ТипЗнч(Значение); 		Если Не ДопустимыеТипыЗначения.СодержитТип(ТипЗначения) Тогда				ДопустимыеТипы = Новый Массив;				Для Каждого Тип Из ДопустимыеТипыЗначения.Типы() Цикл			ДопустимыеТипы.Добавить(Строка(Тип));		КонецЦикла;				ВызватьИсключение СтрШаблон("Для вида сравнения ""%1"" тип значения ""%2"" недопустим. Ожидается значение одного из типов: %3.",			Вид,			ТипЗначения,			СтрСоединить(ДопустимыеТипы, ", "));			КонецЕсли;	КонецПроцедурыФункция СоответствуетУсловию(Значение, ВидСравнения, ЗначениеСравнения)		ТипЗначенияСравнения = ТипЗнч(ЗначениеСравнения);		Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда		СоответствуетУсловию = Значение = ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда		СоответствуетУсловию = Значение <> ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда		СоответствуетУсловию = Значение > ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда		СоответствуетУсловию = Значение >= ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда		СоответствуетУсловию = Значение < ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда		СоответствуетУсловию = Значение <= ЗначениеСравнения;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда				Если ТипЗначенияСравнения = Тип("СписокЗначений") Тогда			СоответствуетУсловию = ЗначениеСравнения.НайтиПоЗначению(Значение) <> Неопределено;		Иначе			СоответствуетУсловию = ЗначениеСравнения.Найти(Значение) <> Неопределено;		КонецЕсли;			ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда				Если ТипЗначенияСравнения = Тип("СписокЗначений") Тогда			СоответствуетУсловию = ЗначениеСравнения.НайтиПоЗначению(Значение) = Неопределено;		Иначе			СоответствуетУсловию = ЗначениеСравнения.Найти(Значение) = Неопределено;		КонецЕсли;			ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда		СоответствуетУсловию = ЗначениеЗаполнено(Значение);	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда		СоответствуетУсловию = Не ЗначениеЗаполнено(Значение);	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда		СоответствуетУсловию = СтрНайти(ВРег(Значение), ВРег(ЗначениеСравнения)) > 0;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда		СоответствуетУсловию = СтрНайти(ВРег(Значение), ВРег(ЗначениеСравнения)) = 0;	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС Тогда		СоответствуетУсловию = Лев(ВРег(Значение), СтрДлина(ЗначениеСравнения)) = ВРег(ЗначениеСравнения);	ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда		СоответствуетУсловию = Лев(ВРег(Значение), СтрДлина(ЗначениеСравнения)) <> ВРег(ЗначениеСравнения);	Иначе		ВызватьИсключение "Неизвестный вид сравнения компоновки данных.";	КонецЕсли;		Возврат СоответствуетУсловию;	КонецФункции

Функция СделатьПлоскимРекурсивно(Массив, КоличествоУровней, Результат)
	
	Для Каждого Элемент Из Массив Цикл
		
		ТипЭлемента = ТипЗнч(Элемент);
		ЭтоМассив = ТипЭлемента = Тип("Массив") Или ТипЭлемента = Тип("ФиксированныйМассив");
		
		Если ЭтоМассив И (КоличествоУровней = -1 Или КоличествоУровней > 0) Тогда
			СледующийУровень = ?(КоличествоУровней = -1, -1, КоличествоУровней - 1);
			ВложенныйМассив = ?(ТипЭлемента = Тип("ФиксированныйМассив"), Новый Массив(Элемент), Элемент);
			СделатьПлоскимРекурсивно(ВложенныйМассив, СледующийУровень, Результат);
		Иначе
			Результат.Добавить(Элемент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти