// Возвращает последний элемент массива.
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо получить последний элемент.
//
// Возвращаемое значение:
//  Произвольный - последний элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Последний = ПоследнийЭлемент(Массив); // 2
//
Функция ПоследнийЭлемент(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Массив[Массив.ВГраница()];

КонецФункции



// Возвращает первый элемент массива.
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо получить первый элемент.
//
// Возвращаемое значение:
//  Произвольный - первый элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Первый = ПервыйЭлемент(Массив); // 1
//
Функция ПервыйЭлемент(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Массив[0];

КонецФункции


// Добавляет элемент в начало массива.
//
// Параметры:
//  Массив - Массив - массив, в начало которого необходимо добавить элемент.
//  Элемент - Произвольный - добавляемый элемент.
//
// Возвращаемое значение:
//  Массив - исходный массив с добавленным элементом.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(2);
//  ДобавитьВНачало(Массив, 1); // [1, 2] 
//
Функция ДобавитьВНачало(Массив, Элемент) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Массив.Вставить(0, Элемент);

	Возврат Массив;

КонецФункции


// Отбирает структуры по значению свойства, сохраняя порядок и повторы.
//
// Параметры:
//  Массив - Массив - структуры или фиксированные структуры. Объекты не копируются.
//  ИмяСвойства - Строка - обязательное имя свойства. Отсутствие свойства вызывает исключение.
//  ВидСравнения - ВидСравненияКомпоновкиДанных - любой вид, кроме иерархических.
//  ЗначениеСравнения - Произвольный - значение для сравнения.
//      Для ВСписке и НеВСписке: Массив, ФиксированныйМассив или СписокЗначений.
//      Для Заполнено и НеЗаполнено: не используется, можно не передавать.
//      Для строковых операций: строка. Поиск подстроки и начала строки без учета регистра.
//      Подобно и НеПодобно используют шаблоны языка запросов (%, _, [...], [^...]).
//      Для упорядоченных сравнений допустимы Число, Строка, Дата одного типа.
//
// Возвращаемое значение:
//  Массив - новый массив подходящих структур.
//
// Примеры:
//  Сотрудники = Новый Массив;
//  Сотрудники.Добавить(Новый Структура("Имя,Возраст,Отдел", "Анна", 25, "Продажи"));
//  Сотрудники.Добавить(Новый Структура("Имя,Возраст,Отдел", "Борис", 35, "Разработка"));
//  Сотрудники.Добавить(Новый Структура("Имя,Возраст,Отдел", "Вера", 30, "Продажи"));
//
//  // Отбор по числовому свойству: структуры Бориса и Веры.
//  Отобранные = Массивы_.ФильтроватьПоСвойству(Сотрудники, "Возраст", ВидСравненияКомпоновкиДанных.БольшеИлиРавно, 30);
//
//  // Отбор по строковому свойству: структуры Анны и Веры.
//  ОтделПродаж = Массивы_.ФильтроватьПоСвойству(Сотрудники, "Отдел", ВидСравненияКомпоновкиДанных.Равно, "Продажи");
//
//  // Исключение указанного значения: структура Бориса.
//  ДругиеОтделы = Массивы_.ФильтроватьПоСвойству(Сотрудники, "Отдел", ВидСравненияКомпоновкиДанных.НеРавно, "Продажи");
//
//  // Нет подходящих элементов: пустой массив.
//  СтаршеСорока = Массивы_.ФильтроватьПоСвойству(Сотрудники, "Возраст", ВидСравненияКомпоновкиДанных.Больше, 40);
//
Функция ФильтроватьПоСвойству(Массив, Знач ИмяСвойства, Знач ВидСравнения, ЗначениеСравнения = Неопределено) Экспорт

	Если ТипЗнч(Массив) <> Тип("Массив") Тогда
		ВызватьИсключение "Параметр ""Массив"" должен иметь тип Массив.";
	КонецЕсли;
	Если ТипЗнч(ВидСравнения) <> Тип("ВидСравненияКомпоновкиДанных") Тогда
		ВызватьИсключение "Параметр ""ВидСравнения"" должен иметь тип ВидСравненияКомпоновкиДанных.";
	КонецЕсли;
	Если ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		ВызватьИсключение "Иерархические виды сравнения не поддерживаются.";
	КонецЕсли;

	УпорядоченноеСравнение = ВидСравнения = ВидСравненияКомпоновкиДанных.Больше
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	СравнениеСоСписком = ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	ПроверкаЗаполненности = ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	СравнениеПоШаблону = ВидСравнения = ВидСравненияКомпоновкиДанных.Подобно
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеПодобно;
	СтроковоеСравнение = СравнениеПоШаблону
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС;
	ТипСравнения = ТипЗнч(ЗначениеСравнения);

	Если СравнениеСоСписком Тогда
		Если ТипСравнения = Тип("СписокЗначений") Тогда
			ЗначенияОтбора = ЗначениеСравнения.ВыгрузитьЗначения();
		ИначеЕсли ТипСравнения = Тип("Массив") Или ТипСравнения = Тип("ФиксированныйМассив") Тогда
			ЗначенияОтбора = ЗначениеСравнения;
		Иначе
			ВызватьИсключение "Для сравнения со списком ожидается Массив, ФиксированныйМассив или СписокЗначений.";
		КонецЕсли;
	КонецЕсли;
	Если СтроковоеСравнение И ТипСравнения <> Тип("Строка") Тогда
		ВызватьИсключение "Для строкового сравнения значение сравнения должно иметь тип Строка.";
	КонецЕсли;
	Если СравнениеПоШаблону Тогда
		// Используем семантику ПОДОБНО платформы, включая диапазоны и отрицания в шаблоне.
		ЗапросШаблона = Новый Запрос;
		ЗапросШаблона.Текст =
			"ВЫБРАТЬ
			| ВЫБОР КОГДА &Значение ПОДОБНО &Шаблон
			| ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Подходит";
		ЗапросШаблона.УстановитьПараметр("Шаблон", ЗначениеСравнения);
	КонецЕсли;
	Если УпорядоченноеСравнение Тогда
		Если ТипСравнения <> Тип("Число") И ТипСравнения <> Тип("Строка")
			И ТипСравнения <> Тип("Дата") Тогда
			ВызватьИсключение "Для упорядоченного сравнения допустимы только Число, Строка или Дата.";
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ИмяСвойства) <> Тип("Строка") Тогда
		ВызватьИсключение "Параметр ""ИмяСвойства"" должен иметь тип Строка.";
	КонецЕсли;
	Если ПустаяСтрока(ИмяСвойства) Тогда
		ВызватьИсключение "Параметр ""ИмяСвойства"" не должен быть пустым.";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента <> Тип("Структура") И ТипЭлемента <> Тип("ФиксированнаяСтруктура") Тогда
			ВызватьИсключение "Элемент массива должен иметь тип Структура или ФиксированнаяСтруктура.";
		КонецЕсли;
		Если Не Элемент.Свойство(ИмяСвойства, ЗначениеЭлемента) Тогда
			ВызватьИсключение СтрШаблон("У элемента массива отсутствует свойство ""%1"".", ИмяСвойства);
		КонецЕсли;

		Если УпорядоченноеСравнение Тогда
			Если ТипЗнч(ЗначениеЭлемента) <> ТипСравнения Тогда
				ВызватьИсключение "Сравниваемые значения должны иметь одинаковый тип: Число, Строка или Дата.";
			КонецЕсли;
		КонецЕсли;

		Если СтроковоеСравнение И ТипЗнч(ЗначениеЭлемента) <> Тип("Строка") Тогда
			ВызватьИсключение "Для строкового сравнения элемент или его свойство должны иметь тип Строка.";
		КонецЕсли;

		Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			Подходит = ЗначениеЭлемента = ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			Подходит = ЗначениеЭлемента <> ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
			Подходит = ЗначениеЭлемента > ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			Подходит = ЗначениеЭлемента >= ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
			Подходит = ЗначениеЭлемента < ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
			Подходит = ЗначениеЭлемента <= ЗначениеСравнения;
		ИначеЕсли СравнениеСоСписком Тогда
			Подходит = ЗначенияОтбора.Найти(ЗначениеЭлемента) <> Неопределено;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ПроверкаЗаполненности Тогда
			Подходит = ЗначениеЗаполнено(ЗначениеЭлемента);
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
			Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
			Подходит = СтрНайти(ВРег(ЗначениеЭлемента), ВРег(ЗначениеСравнения)) > 0;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
			Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
			Подходит = Лев(ВРег(ЗначениеЭлемента), СтрДлина(ЗначениеСравнения)) = ВРег(ЗначениеСравнения);
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли СравнениеПоШаблону Тогда
			ЗапросШаблона.УстановитьПараметр("Значение", ЗначениеЭлемента);
			ВыборкаШаблона = ЗапросШаблона.Выполнить().Выбрать();
			ВыборкаШаблона.Следующий();
			Подходит = ВыборкаШаблона.Подходит;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеПодобно Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		Иначе
			ВызватьИсключение "Неизвестный вид сравнения компоновки данных.";
		КонецЕсли;

		Если Подходит Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отбирает примитивные значения, сохраняя порядок и повторы.
//
// Параметры:
//  Массив - Массив - значения типов Число, Строка, Дата, Булево, Неопределено или Null.
//      Другие типы вызывают исключение.
//  ВидСравнения - ВидСравненияКомпоновкиДанных - любой вид, кроме иерархических.
//  ЗначениеСравнения - Произвольный - значение для сравнения.
//      Для ВСписке и НеВСписке: Массив, ФиксированныйМассив или СписокЗначений.
//      Для Заполнено и НеЗаполнено: не используется, можно не передавать.
//      Для строковых операций: строка. Поиск подстроки и начала строки без учета регистра.
//      Подобно и НеПодобно используют шаблоны языка запросов (%, _, [...], [^...]).
//      Для упорядоченных сравнений допустимы Число, Строка, Дата одного типа.
//
// Возвращаемое значение:
//  Массив - новый массив подходящих значений. Исходный массив не изменяется.
//
Функция ФильтроватьПоЗначению(Массив, Знач ВидСравнения, ЗначениеСравнения = Неопределено) Экспорт

	Если ТипЗнч(Массив) <> Тип("Массив") Тогда
		ВызватьИсключение "Параметр ""Массив"" должен иметь тип Массив.";
	КонецЕсли;
	Если ТипЗнч(ВидСравнения) <> Тип("ВидСравненияКомпоновкиДанных") Тогда
		ВызватьИсключение "Параметр ""ВидСравнения"" должен иметь тип ВидСравненияКомпоновкиДанных.";
	КонецЕсли;
	Если ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
		ВызватьИсключение "Иерархические виды сравнения не поддерживаются.";
	КонецЕсли;

	УпорядоченноеСравнение = ВидСравнения = ВидСравненияКомпоновкиДанных.Больше
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	СравнениеСоСписком = ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	ПроверкаЗаполненности = ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	СравнениеПоШаблону = ВидСравнения = ВидСравненияКомпоновкиДанных.Подобно
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеПодобно;
	СтроковоеСравнение = СравнениеПоШаблону
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
		Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС;
	ТипСравнения = ТипЗнч(ЗначениеСравнения);

	Если СравнениеСоСписком Тогда
		Если ТипСравнения = Тип("СписокЗначений") Тогда
			ЗначенияОтбора = ЗначениеСравнения.ВыгрузитьЗначения();
		ИначеЕсли ТипСравнения = Тип("Массив") Или ТипСравнения = Тип("ФиксированныйМассив") Тогда
			ЗначенияОтбора = ЗначениеСравнения;
		Иначе
			ВызватьИсключение "Для сравнения со списком ожидается Массив, ФиксированныйМассив или СписокЗначений.";
		КонецЕсли;
	КонецЕсли;
	Если СтроковоеСравнение И ТипСравнения <> Тип("Строка") Тогда
		ВызватьИсключение "Для строкового сравнения значение сравнения должно иметь тип Строка.";
	КонецЕсли;
	Если СравнениеПоШаблону Тогда
		// Используем семантику ПОДОБНО платформы, включая диапазоны и отрицания в шаблоне.
		ЗапросШаблона = Новый Запрос;
		ЗапросШаблона.Текст =
			"ВЫБРАТЬ
			| ВЫБОР КОГДА &Значение ПОДОБНО &Шаблон
			| ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ КАК Подходит";
		ЗапросШаблона.УстановитьПараметр("Шаблон", ЗначениеСравнения);
	КонецЕсли;
	Если УпорядоченноеСравнение Тогда
		Если ТипСравнения <> Тип("Число") И ТипСравнения <> Тип("Строка")
			И ТипСравнения <> Тип("Дата") Тогда
			ВызватьИсключение "Для упорядоченного сравнения допустимы только Число, Строка или Дата.";
		КонецЕсли;
	КонецЕсли;
	Если Не СравнениеСоСписком И Не ПроверкаЗаполненности
		И ТипСравнения <> Тип("Число") И ТипСравнения <> Тип("Строка")
		И ТипСравнения <> Тип("Дата") И ТипСравнения <> Тип("Булево")
		И ТипСравнения <> Тип("Неопределено") И ТипСравнения <> Тип("Null") Тогда
		ВызватьИсключение "Значение сравнения должно иметь примитивный тип.";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Массив Цикл
		ТипЭлемента = ТипЗнч(Элемент);
		Если ТипЭлемента <> Тип("Число") И ТипЭлемента <> Тип("Строка")
			И ТипЭлемента <> Тип("Дата") И ТипЭлемента <> Тип("Булево")
			И ТипЭлемента <> Тип("Неопределено") И ТипЭлемента <> Тип("Null") Тогда
			ВызватьИсключение "Элемент массива должен иметь примитивный тип.";
		КонецЕсли;
		ЗначениеЭлемента = Элемент;

		Если УпорядоченноеСравнение Тогда
			Если ТипЗнч(ЗначениеЭлемента) <> ТипСравнения Тогда
				ВызватьИсключение "Сравниваемые значения должны иметь одинаковый тип: Число, Строка или Дата.";
			КонецЕсли;
		КонецЕсли;

		Если СтроковоеСравнение И ТипЗнч(ЗначениеЭлемента) <> Тип("Строка") Тогда
			ВызватьИсключение "Для строкового сравнения элемент или его свойство должны иметь тип Строка.";
		КонецЕсли;

		Если ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			Подходит = ЗначениеЭлемента = ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			Подходит = ЗначениеЭлемента <> ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
			Подходит = ЗначениеЭлемента > ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			Подходит = ЗначениеЭлемента >= ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
			Подходит = ЗначениеЭлемента < ЗначениеСравнения;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
			Подходит = ЗначениеЭлемента <= ЗначениеСравнения;
		ИначеЕсли СравнениеСоСписком Тогда
			Подходит = ЗначенияОтбора.Найти(ЗначениеЭлемента) <> Неопределено;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ПроверкаЗаполненности Тогда
			Подходит = ЗначениеЗаполнено(ЗначениеЭлемента);
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
			Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
			Подходит = СтрНайти(ВРег(ЗначениеЭлемента), ВРег(ЗначениеСравнения)) > 0;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
			Или ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
			Подходит = Лев(ВРег(ЗначениеЭлемента), СтрДлина(ЗначениеСравнения)) = ВРег(ЗначениеСравнения);
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		ИначеЕсли СравнениеПоШаблону Тогда
			ЗапросШаблона.УстановитьПараметр("Значение", ЗначениеЭлемента);
			ВыборкаШаблона = ЗапросШаблона.Выполнить().Выбрать();
			ВыборкаШаблона.Следующий();
			Подходит = ВыборкаШаблона.Подходит;
			Если ВидСравнения = ВидСравненияКомпоновкиДанных.НеПодобно Тогда
				Подходит = Не Подходит;
			КонецЕсли;
		Иначе
			ВызватьИсключение "Неизвестный вид сравнения компоновки данных.";
		КонецЕсли;

		Если Подходит Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает новый массив с обратным порядком элементов.
//
// Параметры:
//  Массив - Массив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив с элементами в обратном порядке.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Массив.Добавить(3);
//
//  ОбратныйМассив = Развернуть(Массив);
//
Функция Развернуть(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Результат = Новый Массив;
	Количество = Массив.Количество();

	Для Индекс = 0 По Количество - 1 Цикл
		Результат.Добавить(Массив[Количество - Индекс - 1]);
	КонецЦикла;

	Возврат Результат;

КонецФункции


// Возвращает часть массива в заданном диапазоне индексов.
//
// Параметры:
//  Массив - Массив - исходный массив.
//  НачальныйИндекс - Число - индекс первого включаемого элемента.
//      Отрицательное значение отсчитывается от конца массива.
//  КонечныйИндекс - Число, Неопределено - индекс элемента, не включаемого
//      в результат. Отрицательное значение отсчитывается от конца массива.
//      Если не указан, используются элементы до конца массива.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий выбранную часть исходного массива.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Массив.Добавить(3);
//  Массив.Добавить(4);
//
//  Результат = Срез(Массив, 1, 3);
//
Функция Срез(
	Массив,
	Знач НачальныйИндекс = 0,
	Знач КонечныйИндекс = Неопределено) Экспорт

	ПроверитьТипМассива(Массив, "Массив");
	ПроверитьЦелоеЧисло(НачальныйИндекс, "НачальныйИндекс");

	Если КонечныйИндекс <> Неопределено Тогда
		ПроверитьЦелоеЧисло(КонечныйИндекс, "КонечныйИндекс");
	КонецЕсли;

	Количество = Массив.Количество();

	Если НачальныйИндекс < 0 Тогда
		НачальныйИндекс = Количество + НачальныйИндекс;
	КонецЕсли;

	Если НачальныйИндекс < 0 Тогда
		НачальныйИндекс = 0;
	ИначеЕсли НачальныйИндекс > Количество Тогда
		НачальныйИндекс = Количество;
	КонецЕсли;

	Если КонечныйИндекс = Неопределено Тогда
		КонечныйИндекс = Количество;
	ИначеЕсли КонечныйИндекс < 0 Тогда
		КонечныйИндекс = Количество + КонечныйИндекс;
	КонецЕсли;

	Если КонечныйИндекс < 0 Тогда
		КонечныйИндекс = 0;
	ИначеЕсли КонечныйИндекс > Количество Тогда
		КонечныйИндекс = Количество;
	КонецЕсли;

	Результат = Новый Массив;

	Если НачальныйИндекс >= КонечныйИндекс Тогда
		Возврат Результат;
	КонецЕсли;

	Для Индекс = НачальныйИндекс По КонечныйИндекс - 1 Цикл
		Результат.Добавить(Массив[Индекс]);
	КонецЦикла;

	Возврат Результат;

КонецФункции


// Объединяет два массива.
//
// Параметры:
//  Массив1 - Массив - первый массив.
//  Массив2 - Массив - второй массив.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы обоих массивов.
//
// Пример:
//  Массив1 = Новый Массив;
//  Массив1.Добавить(1);
//
//  Массив2 = Новый Массив;
//  Массив2.Добавить(2);
//
//  Результат = Объединить(Массив1, Массив2);
//
Функция Объединить(Массив1, Массив2) Экспорт

	ПроверитьТипМассива(Массив1, "Массив1");
	ПроверитьТипМассива(Массив2, "Массив2");

	Результат = Копировать(Массив1);

	Для Каждого Элемент Из Массив2 Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции


// Возвращает минимальный элемент массива или элемент с минимальным
// значением указанного свойства.
//
// Параметры:
//  Массив - Массив - массив, в котором необходимо найти минимальный элемент.
//  ИмяСвойства - Строка - имя свойства, по которому выполняется сравнение.
//      Если не указано, сравниваются сами элементы массива.
//
// Возвращаемое значение:
//  Произвольный - минимальный элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(10);
//  Массив.Добавить(5);
//  Массив.Добавить(20);
//
//  МинимальноеЗначение = Минимум(Массив);
//
Функция Минимум(Массив, Знач ИмяСвойства = "") Экспорт

	ПроверитьТипМассива(Массив, "Массив");
	ПроверитьТипСтроки(ИмяСвойства, "ИмяСвойства");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	МинимальныйЭлемент = Массив[0];
	МинимальноеЗначение = ПолучитьЗначениеДляСравнения(
		МинимальныйЭлемент,
		ИмяСвойства);

	ПроверитьСравнимоеЗначение(МинимальноеЗначение);

	Для Индекс = 1 По Массив.Количество() - 1 Цикл

		Элемент = Массив[Индекс];
		ТекущееЗначение = ПолучитьЗначениеДляСравнения(
			Элемент,
			ИмяСвойства);

		ПроверитьСравнимоеЗначение(ТекущееЗначение);

		Если ТипЗнч(ТекущееЗначение) <> ТипЗнч(МинимальноеЗначение) Тогда
			ВызватьИсключение СтрШаблон(
				"Значение элемента с индексом %1 имеет тип %2, ожидался тип %3.",
				Индекс,
				ТипЗнч(ТекущееЗначение),
				ТипЗнч(МинимальноеЗначение));
		КонецЕсли;

		Если ТекущееЗначение < МинимальноеЗначение Тогда
			МинимальноеЗначение = ТекущееЗначение;
			МинимальныйЭлемент = Элемент;
		КонецЕсли;

	КонецЦикла;

	Возврат МинимальныйЭлемент;

КонецФункции


// Возвращает максимальный элемент массива или элемент с максимальным
// значением указанного свойства.
//
// Параметры:
//  Массив - Массив - массив, в котором необходимо найти максимальный элемент.
//  ИмяСвойства - Строка - имя свойства, по которому выполняется сравнение.
//      Если не указано, сравниваются сами элементы массива.
//
// Возвращаемое значение:
//  Произвольный - максимальный элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(10);
//  Массив.Добавить(5);
//  Массив.Добавить(20);
//
//  МаксимальноеЗначение = Максимум(Массив);
//
Функция Максимум(Массив, Знач ИмяСвойства = "") Экспорт

	ПроверитьТипМассива(Массив, "Массив");
	ПроверитьТипСтроки(ИмяСвойства, "ИмяСвойства");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	МаксимальныйЭлемент = Массив[0];
	МаксимальноеЗначение = ПолучитьЗначениеДляСравнения(
		МаксимальныйЭлемент,
		ИмяСвойства);

	ПроверитьСравнимоеЗначение(МаксимальноеЗначение);

	Для Индекс = 1 По Массив.Количество() - 1 Цикл

		Элемент = Массив[Индекс];
		ТекущееЗначение = ПолучитьЗначениеДляСравнения(
			Элемент,
			ИмяСвойства);

		ПроверитьСравнимоеЗначение(ТекущееЗначение);

		Если ТипЗнч(ТекущееЗначение) <> ТипЗнч(МаксимальноеЗначение) Тогда
			ВызватьИсключение СтрШаблон(
				"Значение элемента с индексом %1 имеет тип %2, ожидался тип %3.",
				Индекс,
				ТипЗнч(ТекущееЗначение),
				ТипЗнч(МаксимальноеЗначение));
		КонецЕсли;

		Если ТекущееЗначение > МаксимальноеЗначение Тогда
			МаксимальноеЗначение = ТекущееЗначение;
			МаксимальныйЭлемент = Элемент;
		КонецЕсли;

	КонецЦикла;

	Возврат МаксимальныйЭлемент;

КонецФункции


// Вычисляет сумму элементов массива.
//
// Параметры:
//  Массив - Массив - массив числовых значений.
//
// Возвращаемое значение:
//  Число - сумма элементов массива.
//  Для пустого массива возвращает 0.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(10);
//  Массив.Добавить(20);
//  Массив.Добавить(30);
//
//  СуммаЗначений = Сумма(Массив);
//
Функция Сумма(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Результат = 0;

	Для Индекс = 0 По Массив.Количество() - 1 Цикл

		Элемент = Массив[Индекс];

		Если ТипЗнч(Элемент) <> Тип("Число") Тогда
			ВызватьИсключение СтрШаблон(
				"Элемент массива с индексом %1 должен иметь тип Число.",
				Индекс);
		КонецЕсли;

		Результат = Результат + Элемент;

	КонецЦикла;

	Возврат Результат;

КонецФункции


// Возвращает массив уникальных значений без повторений.
//
// Параметры:
//  Массив - Массив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий только первые вхождения значений.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//
//  Результат = Уникальные(Массив);
//
Функция Уникальные(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Результат = Новый Массив;

	Для Каждого Элемент Из Массив Цикл

		Если Результат.Найти(Элемент) = Неопределено Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции


// Разбивает массив на группы заданного размера.
//
// Параметры:
//  Массив - Массив - исходный массив.
//  РазмерГруппы - Число - максимальное количество элементов в одной группе.
//      Должно быть положительным целым числом.
//
// Возвращаемое значение:
//  Массив - массив, элементами которого являются массивы-группы.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Массив.Добавить(3);
//  Массив.Добавить(4);
//  Массив.Добавить(5);
//
//  Группы = РазбитьНаГруппы(Массив, 2);
//
Функция РазбитьНаГруппы(Массив, Знач РазмерГруппы) Экспорт

	ПроверитьТипМассива(Массив, "Массив");
	ПроверитьЦелоеЧисло(РазмерГруппы, "РазмерГруппы");

	Если РазмерГруппы <= 0 Тогда
		ВызватьИсключение
			"Параметр ""РазмерГруппы"" должен быть больше нуля.";
	КонецЕсли;

	Результат = Новый Массив;
	ТекущаяГруппа = Новый Массив;

	Для Каждого Элемент Из Массив Цикл

		ТекущаяГруппа.Добавить(Элемент);

		Если ТекущаяГруппа.Количество() = РазмерГруппы Тогда
			Результат.Добавить(ТекущаяГруппа);
			ТекущаяГруппа = Новый Массив;
		КонецЕсли;

	КонецЦикла;

	Если ТекущаяГруппа.Количество() > 0 Тогда
		Результат.Добавить(ТекущаяГруппа);
	КонецЕсли;

	Возврат Результат;

КонецФункции


// Создает копию массива.
//
// Параметры:
//  Массив - Массив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий элементы исходного массива.
//
// Пример:
//  ИсходныйМассив = Новый Массив;
//  ИсходныйМассив.Добавить(1);
//  ИсходныйМассив.Добавить(2);
//
//  КопияМассива = Копировать(ИсходныйМассив);
//
Функция Копировать(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Возврат Новый Массив(
		Новый ФиксированныйМассив(Массив));

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// Служебные процедуры и функции

// Проверяет, что значение имеет тип Массив.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  ИмяПараметра - Строка - имя проверяемого параметра.
//
Процедура ПроверитьТипМассива(Значение, Знач ИмяПараметра)

	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		ВызватьИсключение СтрШаблон(
			"Параметр ""%1"" должен иметь тип Массив.",
			ИмяПараметра);
	КонецЕсли;

КонецПроцедуры


// Проверяет, что значение имеет тип Строка.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  ИмяПараметра - Строка - имя проверяемого параметра.
//
Процедура ПроверитьТипСтроки(Значение, Знач ИмяПараметра)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(
			"Параметр ""%1"" должен иметь тип Строка.",
			ИмяПараметра);
	КонецЕсли;

КонецПроцедуры


// Проверяет, что значение является целым числом.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  ИмяПараметра - Строка - имя проверяемого параметра.
//
Процедура ПроверитьЦелоеЧисло(Значение, Знач ИмяПараметра)

	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение СтрШаблон(
			"Параметр ""%1"" должен иметь тип Число.",
			ИмяПараметра);
	КонецЕсли;

	Если Цел(Значение) <> Значение Тогда
		ВызватьИсключение СтрШаблон(
			"Параметр ""%1"" должен быть целым числом.",
			ИмяПараметра);
	КонецЕсли;

КонецПроцедуры


// Возвращает значение элемента, используемое для сравнения.
//
// Параметры:
//  Элемент - Произвольный - элемент массива.
//  ИмяСвойства - Строка - имя свойства элемента.
//
// Возвращаемое значение:
//  Произвольный - сам элемент или значение указанного свойства.
//
Функция ПолучитьЗначениеДляСравнения(
	Элемент,
	Знач ИмяСвойства)

	Если ПустаяСтрока(ИмяСвойства) Тогда
		Возврат Элемент;
	КонецЕсли;

	ТипЭлемента = ТипЗнч(Элемент);

	Если ТипЭлемента <> Тип("Структура")
		И ТипЭлемента <> Тип("ФиксированнаяСтруктура") Тогда

		ВызватьИсключение СтрШаблон(
			"Для использования свойства ""%1"" элемент массива должен иметь тип Структура или ФиксированнаяСтруктура.",
			ИмяСвойства);

	КонецЕсли;

	Если Не Элемент.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		ВызватьИсключение СтрШаблон(
			"У элемента массива отсутствует свойство ""%1"".",
			ИмяСвойства);
	КонецЕсли;

	Возврат ЗначениеСвойства;

КонецФункции


// Проверяет, что значение поддерживает операции сравнения.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
Процедура ПроверитьСравнимоеЗначение(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения <> Тип("Число")
		И ТипЗначения <> Тип("Строка")
		И ТипЗначения <> Тип("Дата") Тогда

		ВызватьИсключение СтрШаблон(
			"Значение типа %1 не поддерживается для операций сравнения.",
			ТипЗначения);

	КонецЕсли;

КонецПроцедуры


// Проверяет соответствие значения заданному условию.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//  ВидСравнения - Строка - вид сравнения.
//  ЗначениеСравнения - Произвольный - значение для сравнения.
//
// Возвращаемое значение:
//  Булево - Истина, если значение соответствует условию.
//
Функция СоответствуетУсловию(
	Значение,
	Знач ВидСравнения,
	ЗначениеСравнения)

	Если ВидСравнения = "Равно" Тогда
		Возврат Значение = ЗначениеСравнения;
	КонецЕсли;

	Если ВидСравнения = "НеРавно" Тогда
		Возврат Значение <> ЗначениеСравнения;
	КонецЕсли;

	ПроверитьСравнимоеЗначение(Значение);
	ПроверитьСравнимоеЗначение(ЗначениеСравнения);

	Если ТипЗнч(Значение) <> ТипЗнч(ЗначениеСравнения) Тогда
		ВызватьИсключение СтрШаблон(
			"Сравниваемые значения должны иметь одинаковый тип. Переданы типы %1 и %2.",
			ТипЗнч(Значение),
			ТипЗнч(ЗначениеСравнения));
	КонецЕсли;

	Если ВидСравнения = "Больше" Тогда
		Возврат Значение > ЗначениеСравнения;

	ИначеЕсли ВидСравнения = "БольшеИлиРавно" Тогда
		Возврат Значение >= ЗначениеСравнения;

	ИначеЕсли ВидСравнения = "Меньше" Тогда
		Возврат Значение < ЗначениеСравнения;

	ИначеЕсли ВидСравнения = "МеньшеИлиРавно" Тогда
		Возврат Значение <= ЗначениеСравнения;
	КонецЕсли;

	Возврат Ложь;

КонецФункции










