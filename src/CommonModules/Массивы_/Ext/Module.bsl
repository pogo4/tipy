// Возвращает последний элемент массива.
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо получить последний элемент.
//
// Возвращаемое значение:
//  Произвольный - последний элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Последний = ПоследнийЭлемент(Массив); // 2
//
Функция ПоследнийЭлемент(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Массив[Массив.ВГраница()];

КонецФункции



// Возвращает первый элемент массива.
//
// Параметры:
//  Массив - Массив - массив, из которого необходимо получить первый элемент.
//
// Возвращаемое значение:
//  Произвольный - первый элемент массива.
//  Если массив пуст, возвращает Неопределено.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//  Первый = ПервыйЭлемент(Массив); // 1
//
Функция ПервыйЭлемент(Массив) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Массив[0];

КонецФункции


// Добавляет элемент в начало массива.
//
// Параметры:
//  Массив - Массив - массив, в начало которого необходимо добавить элемент.
//  Элемент - Произвольный - добавляемый элемент.
//
// Возвращаемое значение:
//  Массив - исходный массив с добавленным элементом.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(2);
//  ДобавитьВНачало(Массив, 1); // [1, 2] 
//
Функция ДобавитьВНачало(Массив, Элемент) Экспорт

	ПроверитьТипМассива(Массив, "Массив");

	Массив.Вставить(0, Элемент);

	Возврат Массив;

КонецФункции


