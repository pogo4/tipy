// Сортирует элементы массива по возрастанию или убыванию.
//
// Параметры:
//  Массив - Массив - массив значений, который необходимо отсортировать.
//  Направление - Строка - направление сортировки:
//      "Возр" - по возрастанию;
//      "Убыв" - по убыванию.
//      Значение по умолчанию: "Возр".
//
// Возвращаемое значение:
//  Массив - новый массив, содержащий отсортированные значения.
//
// Пример:
//  Массив = Новый Массив;
//  Массив.Добавить(3);
//  Массив.Добавить(1);
//  Массив.Добавить(2);
//
//  Сортировать(Массив, "Возр"); // [1, 2, 3]
//
Функция Сортировать(Массив, Знач Направление = "Возр") Экспорт

    Если ТипЗнч(Массив) <> Тип("Массив") Тогда
        ВызватьИсключение "Параметр ""Массив"" должен иметь тип Массив.";
    КонецЕсли;

    Если ТипЗнч(Направление) <> Тип("Строка") Тогда
        ВызватьИсключение "Параметр ""Направление"" должен иметь тип Строка.";
    КонецЕсли;

    НаправленияСортировки = Новый Соответствие;
    НаправленияСортировки.Вставить("Возр", НаправлениеСортировки.Возр);
    НаправленияСортировки.Вставить("Убыв", НаправлениеСортировки.Убыв);

    НаправлениеСортировкиМассива = НаправленияСортировки[Направление];

    Если НаправлениеСортировкиМассива = Неопределено Тогда
        ВызватьИсключение СтрШаблон(
            "Некорректное значение параметра ""Направление"": %1. Допустимые значения: ""Возр"", ""Убыв"".",
            Направление);
    КонецЕсли;

    СписокЗначений = Новый СписокЗначений;
    СписокЗначений.ЗагрузитьЗначения(Массив);
    СписокЗначений.СортироватьПоЗначению(НаправлениеСортировкиМассива);

    Возврат СписокЗначений.ВыгрузитьЗначения();

КонецФункции

// Определяет, является ли массив пустым.
//
// Параметры:
//  Массив - Массив - массив, для которого необходимо проверить наличие элементов.
//
// Возвращаемое значение:
//  Булево - Истина, если массив не содержит элементов;
//           Ложь, если массив содержит хотя бы один элемент.
//
// Пример:
//  Массивы_.Пустой(Новый Массив); // Истина
//
//  Массив = Новый Массив;
//  Массив.Добавить(2);
//  Массивы_.Пустой(Массив); // Ложь
//
Функция Пустой(Массив) Экспорт

    Если ТипЗнч(Массив) <> Тип("Массив") Тогда
        ВызватьИсключение "Параметр ""Массив"" должен иметь тип Массив.";
    КонецЕсли;

    Возврат Массив.Количество() = 0;

КонецФункции


