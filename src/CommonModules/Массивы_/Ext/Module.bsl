// Новый(п1, п2, п3, п4, п5, п6, п7, п8, п9, п10)
// 


// Создает копию переданного массива.
// Вложенные массивы также копируются, остальные ссылочные объекты
// остаются общими для исходного и результирующего массивов.
//
// Параметры:
//  Массив - Массив - массив, который необходимо скопировать.
//
// Возвращаемое значение:
//  Массив - новый массив с элементами исходного массива.
//
// Исключения:
//  Вызывает исключение "Ожидался массив", если передано значение другого типа.
//
Функция Копировать(Массив) Экспорт

    Если ТипЗнч(Массив) <> Тип("Массив") Тогда
        ВызватьИсключение "Ожидался массив";
    КонецЕсли;

    Возврат Новый Массив(
        Новый ФиксированныйМассив(Массив)
    );

КонецФункции

#КонецОбласти

#Область Обработка

// Возвращает новый массив, содержащий элементы исходного массива
// в обратном порядке.
//
// Параметры:
//  Массив - Массив - исходный массив.
//
// Возвращаемое значение:
//  Массив - новый массив с элементами в обратном порядке.
//
Функция Развернуть(Массив) Экспорт
	
	Если ТипЗнч(Массив) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидался массив";
	КонецЕсли;
	
	НовыйМассив = Новый Массив;
	
	Для Каждого Элемент Из Массив Цикл
		НовыйМассив.Вставить(0, Элемент);
	КонецЦикла;
	
	Возврат НовыйМассив;
	
КонецФункции

#КонецОбласти

#КонецОбласти
