Функция Максимум(Массив, Знач ИмяСвойства = "") Экспорт

	ПроверитьТипМассива(Массив, "Массив");
	ПроверитьТипСтроки(ИмяСвойства, "ИмяСвойства");

	Если Массив.Количество() = 0 Тогда
		Возврат Неопределено;
