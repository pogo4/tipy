#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем ВнутреннийМассив Экспорт;

#Область ПрограммныйИнтерфейс

// Возвращает текущее состояние внутреннего массива.
Функция Получить() Экспорт
	Возврат ВнутреннийМассив;
КонецФункции

// Заменяет каждый элемент результатом вызова выражения
//
// Параметры:
//  Выражение - Структура - см. ВычисляемыеВыражения.Создать
// 
// Возвращаемое значение:
//   - 
//
Функция Применить(Выражение) Экспорт
	
	ПроверитьВыражение(Выражение);
	ВычисляемоеВыражение = СтрШаблон("%1.%2(Элемент, Индекс, Контекст)", Выражение.ИмяМодуляМенеджера, Выражение.ИмяМетода);
	
	НовыйМассив = Новый Массив;
	
	Для Индекс = 0 По ВнутреннийМассив.ВГраница() Цикл
		НовыйМассив.Добавить(ВычислитьВыражение(ВычисляемоеВыражение, ВнутреннийМассив[Индекс], Индекс, Выражение.Контекст));
	КонецЦикла;
	
	ВнутреннийМассив = НовыйМассив;
	
	Возврат ЭтотОбъект;
	
КонецФункции

// filter — оставляет только элементы, для которых выражение(Элемент, Индекс) вернуло Истина.
Функция Фильтр(Выражение) Экспорт
	НовыйМассив = Новый Массив;
	Для Индекс = 0 По ВнутреннийМассив.Количество() - 1 Цикл
		//Если ВычислитьВыражение(Выражение, ВнутреннийМассив[Индекс], Индекс) = Истина Тогда
		//	НовыйМассив.Добавить(ВнутреннийМассив[Индекс]);
		//КонецЕсли;
	КонецЦикла;
	ВнутреннийМассив = НовыйМассив;
	Возврат ЭтотОбъект;
КонецФункции

// reduce — сворачивает массив в одно значение.
// Выражение получает (Аккумулятор, Элемент, Индекс) и возвращает новый аккумулятор.
// Не возвращает ЭтотОбъект — возвращает итоговое накопленное значение.
Функция ПрименитьНакопительно(Выражение, НачальноеЗначение) Экспорт
	Аккумулятор = НачальноеЗначение;
	Для Индекс = 0 По ВнутреннийМассив.Количество() - 1 Цикл
		Аккумулятор = ВызватьВыражениеСАккумулятором(Выражение, Аккумулятор, ВнутреннийМассив[Индекс], Индекс);
	КонецЦикла;
	Возврат Аккумулятор;
КонецФункции

// forEach — вызывает выражение(Элемент, Индекс) для каждого элемента без изменения массива.
Функция ДляКаждого(Выражение) Экспорт
	ПроверитьВыражение(Выражение);
	ВычисляемоеВыражение = СтрШаблон("%1.%2(Элемент, Индекс, Контекст)", Выражение.ИмяМодуляМенеджера, Выражение.ИмяМетода);
	Для Индекс = 0 По ВнутреннийМассив.Количество() - 1 Цикл
		ВычислитьВыражение(ВычисляемоеВыражение, ВнутреннийМассив[Индекс], Индекс, Выражение.Контекст);
	КонецЦикла;
	Возврат ЭтотОбъект;
КонецФункции

// flat — разворачивает вложенные массивы на указанную глубину (по умолчанию 1).
Функция Развернуть(Глубина = 1) Экспорт
	ВнутреннийМассив = РазвернутьРекурсивно(ВнутреннийМассив, Глубина);
	Возврат ЭтотОбъект;
КонецФункции

// flatMap — применяет Применить, затем разворачивает результат на один уровень.
Функция ПрименитьИРазвернуть(Выражение) Экспорт
	Применить(Выражение);
	Развернуть(1);
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Инициализирует объект переданной коллекцией.
//
// Параметры:
//  Коллекция	 - Массив, ФиксированныйМассив, ТаблицаЗначений - 
// 
// Возвращаемое значение:
//  ОбработкаОбъект.ТипыМассив
//
Функция Инициализировать(Коллекция) Экспорт
	
	ВнутреннийМассив = КоллекцияВМассив(Коллекция);
	
	Возврат ЭтотОбъект;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВычислитьВыражение(Выражение, Элемент, Индекс, Контекст)
	Возврат Вычислить(Выражение);
КонецФункции

// Вызывает Обработки.<ИмяОбработки>.<ИмяМетода>(Аккумулятор, Элемент, Индекс) — для ПрименитьНакопительно.
Функция ВызватьВыражениеСАккумулятором(Выражение, Аккумулятор, Элемент, Индекс)
	Возврат Вычислить("Обработки." + Выражение.ИмяОбработки + "." + Выражение.ИмяМетода + "(Аккумулятор, Элемент, Индекс)"); //NOSONAR
КонецФункции

// Рекурсивно разворачивает вложенные массивы на заданную глубину.
Функция РазвернутьРекурсивно(МассивИсточник, Глубина)
	Результат = Новый Массив;
	Для Каждого Элемент Из МассивИсточник Цикл
		Если ТипЗнч(Элемент) = Тип("Массив") И Глубина > 0 Тогда
			ВложенныеЭлементы = РазвернутьРекурсивно(Элемент, Глубина - 1);
			Для Каждого ВложенныйЭлемент Из ВложенныеЭлементы Цикл
				Результат.Добавить(ВложенныйЭлемент);
			КонецЦикла;
		Иначе
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КоллекцияВМассив(Коллекция)
	
	ТипКоллекции = ТипЗнч(Коллекция);
	
	Если ТипКоллекции = Тип("Массив") Тогда
		Результат = Новый Массив(Новый ФиксированныйМассив(Коллекция));
	ИначеЕсли ТипКоллекции = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив(Коллекция);
	Иначе
		Результат = Новый Массив;
		Для Каждого ЭлементКоллекции Из Коллекция Цикл
			Результат.Добавить(ЭлементКоллекции);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьВыражение(Выражение)
	
	Если Строки.СоответствуетОбщимТребованиямКИменам(Выражение.ИмяМодуляМенеджера) = Ложь Тогда
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Указано недопустимое имя модуля менеджера ""%1""'"), Выражение.ИмяМодуляМенеджера);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если Строки.СоответствуетОбщимТребованиямКИменам(Выражение.ИмяМетода) = Ложь Тогда
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Указано недопустимое имя метода ""%1""'"), Выражение.ИмяМетода);
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
