Процедура ИсполняемыеСценарии() Экспорт
	ЮТТесты
		.ДобавитьТестовыйНабор("Массивы")
			.ДобавитьТестовыйНабор("Развернуть")
				.ДобавитьТест("Развернуть_ВозвращаетМассивВОбратномПорядке")
				.ДобавитьТест("Развернуть_НеИзменяетИсходныйМассив")
				.ДобавитьТест("Развернуть_ПереданНеМассив")
        .ДобавитьТестовыйНабор("Копировать")
			.ДобавитьТест("КопияНеЗависитОтИсходногоМассива")
			.ДобавитьТест("ПередачаНеМассиваВызываетИсключение")
			.ДобавитьТест("ВложенныеМассивыКопируются");
	
КонецПроцедуры

Процедура Развернуть_НеИзменяетИсходныйМассив() Экспорт
	
	ИсходныйМассив = Новый Массив;
	ИсходныйМассив.Добавить(1);
	ИсходныйМассив.Добавить(2);
	ИсходныйМассив.Добавить(3);
	
	ОжидаемыйМассив = Новый Массив;
	ОжидаемыйМассив.Добавить(1);
	ОжидаемыйМассив.Добавить(2);
	ОжидаемыйМассив.Добавить(3);
	
	Массивы_.Развернуть(ИсходныйМассив);
	
	ЮТест.ОжидаетЧто(ИсходныйМассив)
		.Равно(ОжидаемыйМассив);
	
КонецПроцедуры

Процедура Развернуть_ВозвращаетМассивВОбратномПорядке() Экспорт
	
	// Подготовка
	ИсходныйМассив = Новый Массив;
	ИсходныйМассив.Добавить(1);
	ИсходныйМассив.Добавить(2);
	ИсходныйМассив.Добавить(3);
	
	ОжидаемыйМассив = Новый Массив;
	ОжидаемыйМассив.Добавить(3);
	ОжидаемыйМассив.Добавить(2);
	ОжидаемыйМассив.Добавить(1);
	
	// Действие
	Результат = Массивы_.Развернуть(ИсходныйМассив);
	
	// Проверка
	ЮТест.ОжидаетЧто(Результат)
		.Равно(ОжидаемыйМассив);
	
КонецПроцедуры

Процедура Развернуть_ПереданНеМассив() Экспорт
	
	// Подготовка
	ИсходноеЗначение = "Это не массив";
	
	// Действие и проверка
	ЮТест.ОжидаетЧто(Массивы_)
	.Метод("Развернуть")
	.Параметр(ИсходноеЗначение)
	.ВыбрасываетИсключение("Ожидался массив");
	
КонецПроцедуры

Процедура КопияНеЗависитОтИсходногоМассива() Экспорт

    ИсходныйМассив = Новый Массив;
    ИсходныйМассив.Добавить("Первый");
    ИсходныйМассив.Добавить("Второй");

    КопияМассива = Массивы_.Копировать(ИсходныйМассив);

    ЮТест.ОжидаетЧто(КопияМассива.Количество())
        .Равно(2);

    ЮТест.ОжидаетЧто(КопияМассива[0])
        .Равно("Первый");

    ЮТест.ОжидаетЧто(КопияМассива[1])
        .Равно("Второй");

    // Проверяем, что функция вернула новый массив,
    // а не ссылку на исходный.
    КопияМассива[0] = "Измененный";

    ЮТест.ОжидаетЧто(ИсходныйМассив[0])
        .Равно("Первый");

КонецПроцедуры

Процедура ВложенныеМассивыКопируются() Экспорт

    ВложенныйМассив = Новый Массив;
    ВложенныйМассив.Добавить("Исходное значение");

    ИсходныйМассив = Новый Массив;
    ИсходныйМассив.Добавить(ВложенныйМассив);

    КопияМассива = Массивы_.Копировать(ИсходныйМассив);
    КопияВложенногоМассива = КопияМассива[0];

    ЮТест.ОжидаетЧто(КопияВложенногоМассива[0])
        .Равно("Исходное значение");

    КопияВложенногоМассива[0] = "Измененное значение";

    ЮТест.ОжидаетЧто(ВложенныйМассив[0])
        .Равно("Исходное значение");

КонецПроцедуры

Процедура ПередачаНеМассиваВызываетИсключение() Экспорт

    ИсключениеВыброшено = Ложь;
    ТекстИсключения = "";

    Попытка
        Массивы_.Копировать("Это не массив");
    Исключение
        ИсключениеВыброшено = Истина;
        ТекстИсключения =
            КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;

    ЮТест.ОжидаетЧто(ИсключениеВыброшено)
        .ЭтоИстина();

    ЮТест.ОжидаетЧто(ТекстИсключения)
        .Содержит("Ожидался массив");

КонецПроцедуры