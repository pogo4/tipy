Процедура Создать_СохраняетПропускиПустуюСтрокуИНоль() Экспорт

	Результат = Массивы_.Создать(1, Неопределено, Неопределено, "три", "", 0);
	Ожидаемый = Новый Массив;
	Ожидаемый.Добавить(1);
	Ожидаемый.Добавить(Неопределено);
	Ожидаемый.Добавить(Неопределено);
	Ожидаемый.Добавить("три");
	Ожидаемый.Добавить("");
	Ожидаемый.Добавить(0);
	ЮТест.ОжидаетЧто(Результат).Равно(Ожидаемый);

КонецПроцедуры

