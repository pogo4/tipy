Процедура Создать_СохраняетВложенныйМассивИБулево() Экспорт
	Вложенный = Новый Массив;
	Вложенный.Добавить("до");
	Результат = Массивы_.Создать(Вложенный, Ложь);
	ЮТест.ОжидаетЧто(Результат.Количество()).Равно(2);
	ЮТест.ОжидаетЧто(Результат[1]).Равно(Ложь);
	Вложенный.Добавить("после");
	ЮТест.ОжидаетЧто(Результат[0].Количество()).Равно(2);

